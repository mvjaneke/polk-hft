@page "/admin"
@model POLK_DOTNET.Pages.AdminModel
@using System.Globalization
@{
    ViewData["Title"] = "Admin";
}

@if (!Model.IsAuthenticated)
{
    <div class="flex items-center justify-center min-h-screen">
        <form method="post" class="p-8 bg-white rounded-lg shadow-md">
            <h1 class="text-2xl font-bold mb-4">Admin Login</h1>
            <input type="password" name="password" class="w-full px-4 py-2 border rounded-md" placeholder="Password" />
            <button type="submit" class="w-full mt-4 px-4 py-2 text-white bg-red-700 rounded-md">Login</button>
        </form>
    </div>
}
else
{
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-4xl font-bold mb-8">Admin Dashboard</h1>

        <div class="border-b border-gray-200">
            <nav class="-mb-px flex space-x-8" aria-label="Tabs">
                <a href="/admin/events" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
                    Event Management &rarr;
                </a>
                <a asp-page="/Admin" asp-route-ActiveTab="gallery" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm @(Model.ActiveTab == "gallery" ? "border-red-700 text-red-800" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
                    Gallery Management
                </a>
                <a asp-page="/Admin" asp-route-ActiveTab="membershipOptions" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm @(Model.ActiveTab == "membershipOptions" ? "border-red-700 text-red-800" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
                    Membership Options
                </a>
                <a asp-page="/Admin" asp-route-ActiveTab="applications" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm @(Model.ActiveTab == "applications" ? "border-red-700 text-red-800" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
                    Membership Applications
                </a>
                <a asp-page="/Admin" asp-route-ActiveTab="committee" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm @(Model.ActiveTab == "committee" ? "border-red-700 text-red-800" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
                    Committee Management
                </a>
                <a asp-page="/Admin" asp-route-ActiveTab="constitution" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm @(Model.ActiveTab == "constitution" ? "border-red-700 text-red-800" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
                    Constitution Management
                </a>
                <a asp-page="/Admin" asp-route-ActiveTab="settings" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm @(Model.ActiveTab == "settings" ? "border-red-700 text-red-800" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
                    Settings
                </a>
            </nav>
        </div>

        <div class="pt-8">
            @if (Model.ActiveTab == "gallery")
            {
                <div>
                    <h2 class="text-2xl font-bold mb-4">Gallery Management</h2>

                    @if (Model.SelectedAlbum != null)
                    {
                        <!-- Album Detail View -->
                        <div class="mb-6">
                            <a asp-page="/Admin" asp-route-ActiveTab="gallery" class="inline-flex items-center text-red-700 hover:text-red-800 font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><polyline points="15 18 9 12 15 6"></polyline></svg>
                                Back to Albums
                            </a>
                        </div>

                        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                            <!-- Edit Album Details -->
                            <form method="post" asp-page-handler="EditAlbum" class="space-y-4 mb-4">
                                <input type="hidden" name="id" value="@Model.SelectedAlbum.Id" />
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Title</label>
                                        <input type="text" name="Title" value="@Model.SelectedAlbum.Title" class="w-full px-4 py-2 border rounded-md" required />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Event Date</label>
                                        <input type="date" name="EventDate" value="@Model.SelectedAlbum.EventDate.ToString("yyyy-MM-dd")" class="w-full px-4 py-2 border rounded-md" required />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Category</label>
                                        @{
                                            var albumCategories = new[] {
                                                new { Value = "competition", Label = "Competition" },
                                                new { Value = "training", Label = "Training" },
                                                new { Value = "social", Label = "Social" },
                                                new { Value = "awards", Label = "Awards" }
                                            };
                                        }
                                        <select name="Category" class="w-full px-4 py-2 border rounded-md" required>
                                            @foreach (var cat in albumCategories)
                                            {
                                                if (cat.Value == Model.SelectedAlbum.Category)
                                                {
                                                    <option value="@cat.Value" selected>@cat.Label</option>
                                                }
                                                else
                                                {
                                                    <option value="@cat.Value">@cat.Label</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Description (optional)</label>
                                        <input type="text" name="Description" value="@Model.SelectedAlbum.Description" class="w-full px-4 py-2 border rounded-md" placeholder="Description" />
                                    </div>
                                </div>
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-4">
                                        <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md hover:bg-red-800 text-sm">Save Changes</button>
                                        <span class="text-sm text-gray-500">@Model.SelectedAlbum.Images.Count image(s)</span>
                                    </div>
                                    <form method="post" asp-page-handler="DeleteAlbum" asp-route-id="@Model.SelectedAlbum.Id" onsubmit="return confirm('Are you sure? This will delete the album and ALL its images.');">
                                        <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md hover:bg-red-800 text-sm">Delete Album</button>
                                    </form>
                                </div>
                            </form>

                            <!-- Bulk Upload Form -->
                            <form method="post" asp-page-handler="UploadImages" enctype="multipart/form-data" class="border-t pt-4">
                                <input type="hidden" name="albumId" value="@Model.SelectedAlbum.Id" />
                                <label class="block text-sm font-medium text-gray-700 mb-2">Upload Images (select multiple)</label>
                                <div class="flex items-center gap-4">
                                    <input type="file" name="images" multiple accept="image/*" class="flex-1" required />
                                    <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md hover:bg-red-800 whitespace-nowrap">Upload Images</button>
                                </div>
                            </form>
                        </div>

                        <!-- Album Images Grid -->
                        @if (Model.SelectedAlbum.Images.Any())
                        {
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                                @foreach (var image in Model.SelectedAlbum.Images)
                                {
                                    <div class="relative group rounded-lg overflow-hidden shadow-md">
                                        <img src="@image.FileName" alt="@image.Title" class="w-full aspect-square object-cover" />
                                        <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                                            <form method="post" asp-page-handler="SetCoverImage">
                                                <input type="hidden" name="imageId" value="@image.Id" />
                                                <input type="hidden" name="albumId" value="@Model.SelectedAlbum.Id" />
                                                <button type="submit" class="bg-white text-gray-800 rounded-full p-2 hover:bg-gray-100" title="Set as cover">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="DeleteImage" onsubmit="return confirm('Delete this image?');">
                                                <input type="hidden" name="id" value="@image.Id" />
                                                <input type="hidden" name="albumId" value="@Model.SelectedAlbum.Id" />
                                                <button type="submit" class="bg-red-700 text-white rounded-full p-2 hover:bg-red-800" title="Delete image">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                        @if (Model.SelectedAlbum.CoverImageFileName == image.FileName)
                                        {
                                            <div class="absolute top-2 left-2 bg-red-700 text-white text-xs font-bold px-2 py-1 rounded">COVER</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-12 bg-white rounded-lg shadow-md">
                                <p class="text-gray-500">No images in this album yet. Upload some above.</p>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Album List View -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                            <div>
                                <h3 class="text-xl font-semibold mb-3">Create New Album</h3>
                                <form method="post" asp-page-handler="CreateAlbum" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                                    <input type="text" name="Title" class="w-full px-4 py-2 border rounded-md" placeholder="Album Title (e.g. February 2026 Competition)" required />
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Event Date</label>
                                        <input type="date" name="EventDate" class="w-full px-4 py-2 border rounded-md" required />
                                    </div>
                                    <select name="Category" class="w-full px-4 py-2 border rounded-md" required>
                                        <option value="" disabled selected>Select a category...</option>
                                        <option value="competition">Competition</option>
                                        <option value="training">Training</option>
                                        <option value="social">Social</option>
                                        <option value="awards">Awards</option>
                                    </select>
                                    <textarea name="Description" class="w-full px-4 py-2 border rounded-md" placeholder="Description (optional)" rows="2"></textarea>
                                    <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md hover:bg-red-800">Create Album</button>
                                </form>
                            </div>
                            <div>
                                <h3 class="text-xl font-semibold mb-3">Albums (@(Model.GalleryAlbums?.Count ?? 0))</h3>
                                @if (Model.GalleryAlbums != null && Model.GalleryAlbums.Any())
                                {
                                    <div class="space-y-3">
                                        @foreach (var album in Model.GalleryAlbums)
                                        {
                                            <a asp-page="/Admin" asp-route-ActiveTab="gallery" asp-route-SelectedAlbumId="@album.Id" class="block bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden">
                                                <div class="flex items-center">
                                                    <div class="w-24 h-24 flex-shrink-0">
                                                        @if (!string.IsNullOrEmpty(album.CoverImageFileName))
                                                        {
                                                            <img src="@album.CoverImageFileName" alt="@album.Title" class="w-full h-full object-cover" />
                                                        }
                                                        else
                                                        {
                                                            <div class="w-full h-full bg-gray-200 flex items-center justify-center">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path><circle cx="12" cy="13" r="3"></circle></svg>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="flex-1 p-4">
                                                        <h4 class="font-semibold text-gray-900">@album.Title</h4>
                                                        <div class="flex items-center gap-2 mt-1">
                                                            <span class="text-xs font-semibold py-1 px-2 uppercase rounded-full bg-gray-100 text-gray-800">@album.Category</span>
                                                            <span class="text-sm text-gray-500">@album.Images.Count image(s)</span>
                                                        </div>
                                                        <span class="text-xs text-gray-400 mt-1 block">@album.EventDate.ToString("dd MMM yyyy")</span>
                                                    </div>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-gray-600 bg-white rounded-lg shadow-md p-6">No albums yet. Create one to get started.</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Model.ActiveTab == "membershipOptions")
            {
                <div>
                    <h2 class="text-2xl font-bold mb-4">Membership Option Management</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-xl font-semibold mb-3">Add New Option</h3>
                            <form method="post" asp-page-handler="AddMembershipOption" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                                <input type="text" name="Title" class="w-full px-4 py-2 border rounded-md" placeholder="Title" required />
                                <input type="text" name="Price" class="w-full px-4 py-2 border rounded-md" placeholder="Price (e.g., R150/month)" required />
                                <textarea name="Features" rows="4" class="w-full px-4 py-2 border rounded-md" placeholder="Features (one per line)" required></textarea>
                                <input type="number" name="DisplayOrder" class="w-full px-4 py-2 border rounded-md" placeholder="Display Order" required />
                                <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md hover:bg-red-800">Add Membership Option</button>
                            </form>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold mb-3">Current Options</h3>
                            <table class="w-full bg-white rounded-lg shadow-md">
                                <thead>
                                    <tr class="border-b">
                                        <th class="text-left p-4">Order</th>
                                        <th class="text-left p-4">Title</th>
                                        <th class="text-left p-4">Price</th>
                                        <th class="text-left p-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var option in Model.MembershipOptions)
                                    {
                                        <tr class="border-b last:border-none">
                                            <td class="p-4">@option.DisplayOrder</td>
                                            <td class="p-4">@option.Title</td>
                                            <td class="p-4">@option.Price</td>
                                            <td class="p-4 flex items-center space-x-2">
                                                <a asp-page="/EditMembershipOption" asp-route-id="@option.Id" class="text-blue-500 hover:underline">Edit</a>
                                                <form method="post" asp-page-handler="DeleteMembershipOption" asp-route-id="@option.Id">
                                                    <button type="submit" class="text-red-500 hover:underline bg-transparent border-none p-0">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @if (Model.ActiveTab == "applications")
            {
                <div>
                    <h2 class="text-2xl font-bold mb-4">Membership Applications</h2>
                    <div class="overflow-x-auto bg-white rounded-lg shadow-md">
                        <table class="w-full mt-2">
                            <thead>
                                <tr class="border-b">
                                    <th class="text-left p-4">ID</th>
                                    <th class="text-left p-4">Type</th>
                                    <th class="text-left p-4">Total</th>
                                    <th class="text-left p-4">Status</th>
                                    <th class="text-left p-4">Submitted</th>
                                    <th class="text-left p-4">Members</th>
                                    <th class="text-left p-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.MembershipApplications)
                                {
                                    <tr class="border-b last:border-none">
                                        <td class="p-4">@app.Id</td>
                                        <td class="p-4">@app.MembershipType</td>
                                        <td class="p-4">@($"R{app.TotalAmount:F2}")</td>
                                        <td class="p-4">@app.Status</td>
                                        <td class="p-4">@app.SubmittedDate.ToShortDateString()</td>
                                        <td class="p-4">
                                            @foreach (var member in app.Members)
                                            {
                                                <div>@member.FirstName @member.Surname (@member.EmailAddress)</div>
                                            }
                                        </td>
                                        <td class="p-4 flex items-center space-x-2">
                                            @if (app.Status == "Pending")
                                            {
                                                <form method="post" asp-page-handler="ApproveApplication" asp-route-id="@app.Id">
                                                    <button type="submit" class="text-green-500 hover:underline bg-transparent border-none p-0">Approve</button>
                                                </form>
                                                <form method="post" asp-page-handler="RejectApplication" asp-route-id="@app.Id">
                                                    <button type="submit" class="text-red-500 hover:underline bg-transparent border-none p-0">Reject</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span>@app.Status</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (Model.ActiveTab == "committee")
            {
                <div>
                    <h2 class="text-2xl font-bold mb-4">Committee Management</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-xl font-semibold mb-3">Add New Committee Member</h3>
                            <form method="post" asp-page-handler="AddCommitteeMember" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                                <input type="text" name="name" class="w-full px-4 py-2 border rounded-md" placeholder="Name" required />
                                <input type="text" name="position" class="w-full px-4 py-2 border rounded-md" placeholder="Position" required />
                                <input type="number" name="order" class="w-full px-4 py-2 border rounded-md" placeholder="Order" required />
                                <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md">Add Member</button>
                            </form>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold mb-3">Current Committee Members</h3>
                            @if (Model.CommitteeMembers == null || !Model.CommitteeMembers.Any())
                            {
                                <div class="text-gray-600">No committee members found.</div>
                            }
                            else
                            {
                                <table class="w-full bg-white rounded-lg shadow-md">
                                    <thead>
                                        <tr class="border-b">
                                            <th class="text-left p-4">Order</th>
                                            <th class="text-left p-4">Position</th>
                                            <th class="text-left p-4">Name</th>
                                            <th class="text-left p-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var member in Model.CommitteeMembers)
                                        {
                                            <tr class="border-b last:border-none">
                                                <td class="p-4">@member.Order</td>
                                                <td class="p-4">@member.Position</td>
                                                <td class="p-4">@member.Name</td>
                                                <td class="p-4 flex items-center space-x-2">
                                                    <a asp-page="/EditCommitteeMember" asp-route-id="@member.Id" class="text-blue-500 hover:underline">Edit</a>
                                                    <form method="post" asp-page-handler="DeleteCommitteeMember" asp-route-id="@member.Id" onsubmit="return confirm('Are you sure you want to delete this committee member?');">
                                                        <button type="submit" class="text-red-500 hover:underline bg-transparent border-none p-0">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (Model.ActiveTab == "constitution")
            {
                <div>
                    <h2 class="text-2xl font-bold mb-4">Constitution Management</h2>
                    <form method="post" asp-page-handler="SaveConstitution" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                        <textarea id="constitution-editor" name="Content" style="height: 500px;" class="w-full px-4 py-2 border rounded-md" placeholder="Enter Constitution HTML Content">@Model.CurrentConstitution?.Content</textarea>
                        <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md">Save Constitution</button>
                    </form>
                </div>
            }
            
            @if (Model.ActiveTab == "settings")
            {
                <div>
                    <h2 class="text-2xl font-bold mb-4">Site Settings</h2>

                    @if (!string.IsNullOrEmpty(Model.SettingsMessage))
                    {
                        <div class="mb-4 p-4 bg-green-100 text-green-800 rounded-md">@Model.SettingsMessage</div>
                    }

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-xl font-semibold mb-3">Yoco Payment Gateway</h3>
                            <form method="post" asp-page-handler="SaveYocoSettings" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Public Key</label>
                                    <input type="text" name="yocoPublicKey" value="@Model.YocoPublicKey" class="w-full px-4 py-2 border rounded-md" placeholder="pk_live_xxxxxxxx" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Secret Key</label>
                                    <input type="password" name="yocoSecretKey" value="@Model.YocoSecretKey" class="w-full px-4 py-2 border rounded-md" placeholder="sk_live_xxxxxxxx" />
                                </div>
                                <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md hover:bg-red-800">Save Yoco Settings</button>
                            </form>
                        </div>

                        <div>
                            <h3 class="text-xl font-semibold mb-3">Email (SMTP) Settings</h3>
                            <form method="post" asp-page-handler="SaveEmailSettings" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">SMTP Host</label>
                                    <input type="text" name="smtpHost" value="@Model.SmtpHost" class="w-full px-4 py-2 border rounded-md" placeholder="smtp.gmail.com" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">SMTP Port</label>
                                    <input type="number" name="smtpPort" value="@Model.SmtpPort" class="w-full px-4 py-2 border rounded-md" placeholder="587" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">SMTP Username</label>
                                    <input type="text" name="smtpUsername" value="@Model.SmtpUsername" class="w-full px-4 py-2 border rounded-md" placeholder="your-email@gmail.com" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">SMTP Password</label>
                                    <input type="password" name="smtpPassword" value="@Model.SmtpPassword" class="w-full px-4 py-2 border rounded-md" placeholder="App password" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">From Email Address</label>
