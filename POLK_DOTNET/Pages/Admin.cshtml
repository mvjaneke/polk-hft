@page "/admin"
@model POLK_DOTNET.Pages.AdminModel
@using System.Globalization
@{
    ViewData["Title"] = "Admin";
}

@if (!Model.IsAuthenticated)
{
    <div class="flex items-center justify-center min-h-screen">
        <form method="post" class="p-8 bg-white rounded-lg shadow-md">
            <h1 class="text-2xl font-bold mb-4">Admin Login</h1>
            <input type="password" name="password" class="w-full px-4 py-2 border rounded-md" placeholder="Password" />
            <button type="submit" class="w-full mt-4 px-4 py-2 text-white bg-red-700 rounded-md">Login</button>
        </form>
    </div>
}
else
{
    <div x-data="{ activeTab: 'events' }" class="container mx-auto px-4 py-8">
        <h1 class="text-4xl font-bold mb-8">Admin Dashboard</h1>

        <div class="border-b border-gray-200">
            <nav class="-mb-px flex space-x-8" aria-label="Tabs">
                <button x-on:click="activeTab = 'events'"
                        :class="{ 'border-red-700 text-red-800': activeTab === 'events', 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300': activeTab !== 'events' }"
                        class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    Event Management
                </button>
                <button x-on:click="activeTab = 'gallery'"
                        :class="{ 'border-red-700 text-red-800': activeTab === 'gallery', 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300': activeTab !== 'gallery' }"
                        class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    Gallery Management
                </button>
                <button x-on:click="activeTab = 'membershipOptions'"
                        :class="{ 'border-red-700 text-red-800': activeTab === 'membershipOptions', 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300': activeTab !== 'membershipOptions' }"
                        class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    Membership Options
                </button>
                <button x-on:click="activeTab = 'applications'"
                        :class="{ 'border-red-700 text-red-800': activeTab === 'applications', 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300': activeTab !== 'applications' }"
                        class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    Membership Applications
                </button>
                <button x-on:click="activeTab = 'committee'"
                        :class="{ 'border-red-700 text-red-800': activeTab === 'committee', 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300': activeTab !== 'committee' }"
                        class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    Committee Management
                </button>
                <button x-on:click="activeTab = 'constitution'"
                        :class="{ 'border-red-700 text-red-800': activeTab === 'constitution', 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300': activeTab !== 'constitution' }"
                        class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    Constitution Management
                </button>
            </nav>
        </div>

        <div class="pt-8">
            <div x-show="activeTab === 'events'">
                <h2 class="text-2xl font-bold mb-4">Event Management</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <h3 class="text-xl font-semibold mb-3">Add New Event</h3>
                        <form method="post" asp-page-handler="AddEvent" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                            <input type="text" name="Title" class="w-full px-4 py-2 border rounded-md" placeholder="Title" required />
                            <div>
                                <label for="StartDate" class="block text-sm font-medium text-gray-700">Start Date</label>
                                <input type="date" name="StartDate" id="StartDate" class="w-full px-4 py-2 border rounded-md" required />
                            </div>
                            <div>
                                <label for="EndDate" class="block text-sm font-medium text-gray-700">End Date (optional)</label>
                                <input type="date" name="EndDate" id="EndDate" class="w-full px-4 py-2 border rounded-md" />
                            </div>
                            <input type="text" name="Time" class="w-full px-4 py-2 border rounded-md" placeholder="Time" required />
                            <select name="Type" class="w-full px-4 py-2 border rounded-md" required>
                                <option value="" disabled selected>Select an event type...</option>
                                <option value="competition">Competition</option>
                                <option value="training">Training</option>
                                <option value="social">Social</option>
                            </select>
                            <textarea name="Description" class="w-full px-4 py-2 border rounded-md" placeholder="Description" required></textarea>
                            <input type="text" name="Location" class="w-full px-4 py-2 border rounded-md" placeholder="Location" />
                            <input type="number" name="Participants" class="w-full px-4 py-2 border rounded-md" placeholder="Participants" />
                            <input type="number" name="MaxParticipants" class="w-full px-4 py-2 border rounded-md" placeholder="Max Participants" />
                            <select name="Color" class="w-full px-4 py-2 border rounded-md">
                                <option value="bg-red-500" class="bg-red-500 text-white">Red</option>
                                <option value="bg-blue-500" class="bg-blue-500 text-white">Blue</option>
                                <option value="bg-green-500" class="bg-green-500 text-white">Green</option>
                                <option value="bg-yellow-500" class="bg-yellow-500 text-black">Yellow</option>
                                <option value="bg-indigo-500" class="bg-indigo-500 text-white">Indigo</option>
                                <option value="bg-purple-500" class="bg-purple-500 text-white">Purple</option>
                                <option value="bg-pink-500" class="bg-pink-500 text-white">Pink</option>
                                <option value="bg-gray-700" class="bg-gray-700 text-white">Gray</option>
                                <option value="bg-teal-500" class="bg-teal-500 text-white">Teal</option>
                                <option value="bg-orange-500" class="bg-orange-500 text-white">Orange</option>
                            </select>
                            <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md">Add Event</button>
                        </form>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold mb-3">Current Events</h3>
                        <table class="w-full bg-white rounded-lg shadow-md">
                            <thead>
                                <tr class="border-b">
                                    <th class="text-left p-4">Title</th>
                                    <th class="text-left p-4">Date</th>
                                    <th class="text-left p-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ev in Model.Events)
                                {
                                    <tr class="border-b last:border-none">
                                        <td class="p-4">@ev.Title</td>
                                        <td class="p-4">
                                            @ev.StartDate.ToShortDateString()
                                            @if (ev.EndDate.HasValue)
                                            {
                                                <span> - @ev.EndDate.Value.ToShortDateString()</span>
                                            }
                                        </td>
                                        <td class="p-4 flex items-center space-x-2">
                                            <a asp-page="/EditEvent" asp-route-id="@ev.Id" class="text-blue-500 hover:underline">Edit</a>
                                            <form method="post" asp-page-handler="DeleteEvent" asp-route-id="@ev.Id">
                                                <button type="submit" class="text-red-500 hover:underline bg-transparent border-none p-0">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div x-show="activeTab === 'gallery'">
                <h2 class="text-2xl font-bold mb-4">Gallery Management</h2>
                 <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <h3 class="text-xl font-semibold mb-3">Add New Image</h3>
                        <form method="post" asp-page-handler="AddImage" enctype="multipart/form-data" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                            <input type="file" name="Image" class="w-full" required />
                            <input type="text" name="Title" class="w-full px-4 py-2 border rounded-md" placeholder="Title" required />
                            <select name="Category" class="w-full px-4 py-2 border rounded-md" required>
                                <option value="" disabled selected>Select a category...</option>
                                <option value="competition">Competition</option>
                                <option value="training">Training</option>
                                <option value="social">Social</option>
                                <option value="awards">Awards</option>
                            </select>
                            <textarea name="Description" class="w-full px-4 py-2 border rounded-md" placeholder="Description" required></textarea>
                            <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md">Add Image</button>
                        </form>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold mb-3">Current Gallery</h3>
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mt-8">
                            @foreach (var image in Model.GalleryImages)
                            {
                                <div class="relative group">
                                    <img src="@image.FileName" class="w-full h-full object-cover rounded-md" />
                                    <form method="post" asp-page-handler="DeleteImage" asp-route-id="@image.Id">
                                        <button type="submit" class="absolute top-2 right-2 bg-red-700 text-white rounded-full p-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div x-show="activeTab === 'membershipOptions'">
                <h2 class="text-2xl font-bold mb-4">Membership Option Management</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <h3 class="text-xl font-semibold mb-3">Add New Option</h3>
                        <form method="post" asp-page-handler="AddMembershipOption" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                            <input type="text" name="Title" class="w-full px-4 py-2 border rounded-md" placeholder="Title" required />
                            <input type="text" name="Price" class="w-full px-4 py-2 border rounded-md" placeholder="Price (e.g., R150/month)" required />
                            <textarea name="Features" rows="4" class="w-full px-4 py-2 border rounded-md" placeholder="Features (one per line)" required></textarea>
                            <input type="number" name="DisplayOrder" class="w-full px-4 py-2 border rounded-md" placeholder="Display Order" required />
                            <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md hover:bg-red-800">Add Membership Option</button>
                        </form>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold mb-3">Current Options</h3>
                        <table class="w-full bg-white rounded-lg shadow-md">
                            <thead>
                                <tr class="border-b">
                                    <th class="text-left p-4">Order</th>
                                    <th class="text-left p-4">Title</th>
                                    <th class="text-left p-4">Price</th>
                                    <th class="text-left p-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var option in Model.MembershipOptions)
                                {
                                    <tr class="border-b last:border-none">
                                        <td class="p-4">@option.DisplayOrder</td>
                                        <td class="p-4">@option.Title</td>
                                        <td class="p-4">@option.Price</td>
                                        <td class="p-4 flex items-center space-x-2">
                                            <a asp-page="/EditMembershipOption" asp-route-id="@option.Id" class="text-blue-500 hover:underline">Edit</a>
                                            <form method="post" asp-page-handler="DeleteMembershipOption" asp-route-id="@option.Id">
                                                <button type="submit" class="text-red-500 hover:underline bg-transparent border-none p-0">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div x-show="activeTab === 'applications'">
                <h2 class="text-2xl font-bold mb-4">Membership Applications</h2>
                <div class="overflow-x-auto bg-white rounded-lg shadow-md">
                    <table class="w-full mt-2">
                        <thead>
                            <tr class="border-b">
                                <th class="text-left p-4">ID</th>
                                <th class="text-left p-4">Type</th>
                                <th class="text-left p-4">Total</th>
                                <th class="text-left p-4">Status</th>
                                <th class="text-left p-4">Submitted</th>
                                <th class="text-left p-4">Members</th>
                                <th class="text-left p-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.MembershipApplications)
                            {
                                <tr class="border-b last:border-none">
                                    <td class="p-4">@app.Id</td>
                                    <td class="p-4">@app.MembershipType</td>
                                    <td class="p-4">@app.TotalAmount.ToString("C")</td>
                                    <td class="p-4">@app.Status</td>
                                    <td class="p-4">@app.SubmittedDate.ToShortDateString()</td>
                                    <td class="p-4">
                                        @foreach (var member in app.Members)
                                        {
                                            <div>@member.FirstName @member.Surname (@member.EmailAddress)</div>
                                        }
                                    </td>
                                    <td class="p-4 flex items-center space-x-2">
                                        @if (app.Status == "Pending")
                                        {
                                            <form method="post" asp-page-handler="ApproveApplication" asp-route-id="@app.Id">
                                                <button type="submit" class="text-green-500 hover:underline bg-transparent border-none p-0">Approve</button>
                                            </form>
                                            <form method="post" asp-page-handler="RejectApplication" asp-route-id="@app.Id">
                                                <button type="submit" class="text-red-500 hover:underline bg-transparent border-none p-0">Reject</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span>@app.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div x-show="activeTab === 'committee'">                <h2 class="text-2xl font-bold mb-4">Committee Management</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <h3 class="text-xl font-semibold mb-3" x-text="editingMember ? 'Edit Committee Member' : 'Add New Committee Member'"></h3>
                        <form method="post" asp-page-handler="AddCommitteeMember" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                            <input type="hidden" name="Id" value="0" />
                            <input type="text" name="Name" class="w-full px-4 py-2 border rounded-md" placeholder="Name" required />
                            <input type="text" name="Position" class="w-full px-4 py-2 border rounded-md" placeholder="Position" required />
                            <input type="number" name="Order" class="w-full px-4 py-2 border rounded-md" placeholder="Order" required />
                            <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md">Add Member</button>
                        </form>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold mb-3">Current Committee Members</h3>
                        @if (Model.CommitteeMembers == null || !Model.CommitteeMembers.Any())
                        {
                            <div class="text-gray-600">No committee members found.</div>
                        }
                        else
                        {
                            <table class="w-full bg-white rounded-lg shadow-md">
                                <thead>
                                    <tr class="border-b">
                                        <th class="text-left p-4">Order</th>
                                        <th class="text-left p-4">Position</th>
                                        <th class="text-left p-4">Name</th>
                                        <th class="text-left p-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var member in Model.CommitteeMembers)
                                    {
                                        <tr class="border-b last:border-none">
                                            <td class="p-4">@member.Order</td>
                                            <td class="p-4">@member.Position</td>
                                            <td class="p-4">@member.Name</td>
                                            <td class="p-4 flex items-center space-x-2">
                                                <a asp-page="/EditCommitteeMember" asp-route-id="@member.Id" class="text-blue-500 hover:underline">Edit</a>
                                                <form method="post" asp-page-handler="DeleteCommitteeMember" asp-route-id="@member.Id" onsubmit="return confirm('Are you sure you want to delete this committee member?');">
                                                    <button type="submit" class="text-red-500 hover:underline bg-transparent border-none p-0">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>                </div>
            </div>

            <div x-show="activeTab === 'constitution'" x-data="constitutionManagement()" x-init="initCKEditor()">
                <h2 class="text-2xl font-bold mb-4">Constitution Management</h2>
                <form x-on:submit.prevent="saveConstitution()" class="space-y-4 p-6 bg-white rounded-lg shadow-md">
                    <textarea id="constitution-editor" style="height: 500px;" class="w-full px-4 py-2 border rounded-md" placeholder="Enter Constitution HTML Content"></textarea>
                    <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md">Save Constitution</button>
                </form>
            </div>
        </div>
    </div>
}

<script>
    let currentEditorInstance = null; // Declare a variable outside the Alpine return object


    function constitutionManagement() {
        console.log('constitutionManagement() component initialized');
        return {
            // editor: null, // No longer needed as a reactive property
            form: {
                content: ''
            },
            initCKEditor() {
                this.$nextTick(async () => {
                    console.log('Attempting to initialize CKEditor...');
                    const editorElement = document.querySelector('#constitution-editor');
                    console.log('Editor element found:', editorElement);
                    console.log('ClassicEditor defined:', typeof ClassicEditor !== 'undefined');

                    if (editorElement && typeof ClassicEditor !== 'undefined') {
                        ClassicEditor
                            .create(editorElement, {
                                // CKEditor configuration (plugins, toolbar, etc.)
                                toolbar: {
                                    items: [
                                        'heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', '|',
                                        'blockQuote', 'insertTable', 'undo', 'redo'
                                    ]
                                }
                            })
                            .then(editor => {
                                currentEditorInstance = editor; // Store in the non-reactive variable
                                console.log('CKEditor initialized:', currentEditorInstance);
                                // Pass the editor instance directly to fetchConstitutionContent
                                this.fetchConstitutionContent(currentEditorInstance);
                                currentEditorInstance.model.document.on('change:data', () => {
                                    this.form.content = currentEditorInstance.getData();
                                });
                            })
                            .catch(error => {
                                console.error('Error initializing CKEditor:', error);
                            });
                    } else {
                        console.warn('CKEditor initialization skipped: editor element not found or ClassicEditor not defined.');
                    }
                });
            },
            async fetchConstitutionContent(editorInstance) { // Accept editorInstance as argument
                console.log('Fetching Constitution content...');
                const response = await fetch('/api/Constitution');
                const constitution = await response.json();
                this.form.content = constitution.content; // Update Alpine form model
                console.log('Fetched Constitution content:', this.form.content.substring(0, 500) + '...');
                
                if (editorInstance && this.form.content) { // Use editorInstance instead of this.editor
                    // Parse the HTML document and clean it up as before
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(this.form.content, 'text/html');

                    let contentToLoad = '';
                    const wordSection = doc.querySelector('.WordSection1');
                    if (wordSection) {
                        contentToLoad = wordSection.innerHTML;
                        console.log('Extracted content from .WordSection1');
                    } else if (doc.body) {
                        contentToLoad = doc.body.innerHTML;
                        console.log('Extracted content from <body>');
                    } else {
                        console.warn('Could not extract content from .WordSection1 or <body>. Using full fetched content.');
                        contentToLoad = this.form.content;
                    }

                    // --- Basic HTML Cleanup (to ensure no script/style tags cause issues) ---
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = contentToLoad;
                    tempDiv.querySelectorAll('script, style').forEach(el => el.remove());
                    
                    const cleanedContent = tempDiv.innerHTML;
                    console.log('Attempting to set CKEditor content after basic cleanup:', cleanedContent.substring(0, 500) + '...');

                    setTimeout(() => {
                        editorInstance.setData(cleanedContent); 
                        console.log('Constitution content set in CKEditor after cleanup and delay.');
                    }, 50);

                } else if (!editorInstance) { // Use editorInstance
                    console.error('CKEditor instance is not available when trying to set content.');
                } else if (!this.form.content) {
                    console.warn('Fetched Constitution content is empty or null.');
                }
            },
            async saveConstitution() {
                if (currentEditorInstance) { // Use the non-reactive global variable
                    this.form.content = currentEditorInstance.getData();
                }
                const response = await fetch('/api/Constitution', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(this.form)
                });
                if (response.ok) { alert('Constitution saved successfully!'); }
                else {
                    const errorText = await response.text();
                    console.error('Failed to save constitution. Status:', response.status, response.statusText, 'Response:', errorText);
                    alert('Failed to save constitution. Check console for details.');
                }
            }
        }
    }
</script>