@page "/apply"
@model POLK_DOTNET.Pages.ApplyModel
@using POLK_DOTNET.Data
@using POLK_DOTNET.Services
@{
    ViewData["Title"] = "Membership Application";
    var year = Model.Year;
    var people = Model.Input.People;
    string R(decimal v) => MembershipService.Money(v);
}

<style>
    .form-input {
        display: block; width: 100%;
        padding: 0.625rem 0.875rem; font-size: 1rem; line-height: 1.5; color: #111827;
        background: #fff; border: 1px solid #d1d5db; border-radius: 0.5rem;
        transition: border-color .15s, box-shadow .15s;
    }
    .form-input:focus { outline: none; border-color: #b91c1c; box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.15); }
    .input-validation-error.form-input, .form-input.input-error { border-color: #dc2626; background: #fffafa; }
    .form-label { display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.375rem; }
    .form-label .optional { font-weight: 400; color: #6b7280; }
    .form-hint { font-size: 0.8125rem; color: #6b7280; margin-top: 0.25rem; }
    .form-error { font-size: 0.8125rem; color: #b91c1c; margin-top: 0.25rem; display: block; }
    .form-error:empty { display: none; }

    .step { scroll-margin-top: 5rem; }
    .step-head { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #b91c1c; }
    .step-num {
        flex: none; display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem;
        border-radius: 999px; background: #b91c1c; color: #fff; font-weight: 700; font-size: 0.875rem;
        transform: translateY(0.15rem);
    }
    .step-title { font-size: 1.125rem; font-weight: 700; color: #111827; }
    .step-error .step-num { background: #7f1d1d; box-shadow: 0 0 0 3px #fecaca; }

    .choice {
        position: relative; display: flex; gap: 0.75rem; align-items: flex-start;
        padding: 0.875rem 1rem; border: 1px solid #d1d5db; border-radius: 0.625rem;
        background: #fff; cursor: pointer; transition: border-color .15s, background .15s;
    }
    .choice:hover { border-color: #b91c1c; }
    .choice input { margin-top: 0.2rem; width: 1.05rem; height: 1.05rem; accent-color: #b91c1c; flex: none; }
    .choice:has(input:checked) { border-color: #b91c1c; background: #fef2f2; box-shadow: inset 0 0 0 1px #b91c1c; }
    .choice:has(input:focus-visible) { outline: 2px solid #b91c1c; outline-offset: 2px; }
    .choice-title { font-weight: 700; color: #111827; }
    .choice-text { font-size: 0.875rem; color: #4b5563; margin-top: 0.125rem; }
    .choice-price { font-size: 1.375rem; font-weight: 800; color: #991b1b; letter-spacing: -0.01em; margin-top: 0.25rem; font-variant-numeric: tabular-nums; }

    .person-card { border: 1px solid #e5e7eb; border-left: 4px solid #b91c1c; border-radius: 0.75rem; background: #fff; padding: 1.25rem; }
    .person-card-error { border-color: #fca5a5; border-left-width: 6px; background: #fffbfb; }
    .person-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; padding-bottom: 0.625rem; border-bottom: 1px solid #f3f4f6; }
    .person-title { font-weight: 700; color: #111827; }
    .person-role { font-weight: 400; color: #6b7280; font-size: 0.875rem; }
    .fix-chip { display: inline-block; margin-left: 0.5rem; padding: 0.125rem 0.5rem; border-radius: 999px; background: #b91c1c; color: #fff; font-size: 0.6875rem; font-weight: 700; vertical-align: 0.1em; }
    .link-btn { background: none; border: none; padding: 0; font-size: 0.875rem; color: #b91c1c; text-decoration: underline; cursor: pointer; }
    .ghost-btn {
        display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.125rem;
        font-size: 0.9375rem; font-weight: 600; color: #b91c1c; background: #fff;
        border: 1px dashed #b91c1c; border-radius: 0.5rem; cursor: pointer;
    }
    .ghost-btn:hover { background: #fef2f2; }
    .check { display: flex; gap: 0.625rem; align-items: flex-start; cursor: pointer; }
    .check input { margin-top: 0.2rem; width: 1.05rem; height: 1.05rem; accent-color: #b91c1c; flex: none; }

    .legal-box { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.5rem; padding: 1rem 1.25rem; font-size: 0.875rem; color: #374151; line-height: 1.6; }
    .legal-box li { margin-bottom: 0.375rem; padding-left: 0.25rem; }
    .info-box { border: 1px solid #fde68a; background: #fffbeb; border-radius: 0.625rem; padding: 1rem 1.25rem; color: #78350f; font-size: 0.9375rem; }
    .info-box table td { padding: 0.125rem 1.5rem 0.125rem 0; font-variant-numeric: tabular-nums; }
    .bank-box { border: 1px solid #e5e7eb; background: #f9fafb; border-radius: 0.625rem; padding: 1rem 1.25rem; font-size: 0.9375rem; }
    .bank-box dt { color: #6b7280; }
    .bank-box dd { font-weight: 600; color: #111827; font-variant-numeric: tabular-nums; }

    /* The ticket: what you're paying for, kept in view while you fill the form in. It reacts to
       the radio buttons with :has() alone, so it works without any script. The server works the
       amount out again from the year's fees when the form is submitted. */
    .ticket { background: #fff; border-radius: 0.875rem; box-shadow: 0 1px 2px rgba(17,24,39,.06), 0 8px 24px rgba(127,29,29,.10); overflow: hidden; }
    .ticket-head { background: #991b1b; color: #fff; padding: 1.125rem 1.25rem 1rem; }
    .ticket-club { font-size: 0.8125rem; color: #fecaca; }
    .ticket-year { font-size: 2rem; font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
    .ticket-dates { font-size: 0.8125rem; color: #fee2e2; margin-top: 0.25rem; }
    .ticket-body { padding: 1rem 1.25rem 0.5rem; }
    .ticket-row { display: none; justify-content: space-between; gap: 1rem; padding: 0.375rem 0; font-size: 0.9375rem; color: #1f2937; }
    .ticket-row span:last-child { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ticket-row.muted { color: #6b7280; font-size: 0.875rem; }
    .ticket-row.always { display: flex; }
    .ticket-tear { position: relative; height: 1.5rem; margin: 0.25rem -1.25rem 0; }
    .ticket-tear::before { content: ""; position: absolute; left: 1rem; right: 1rem; top: 50%; border-top: 2px dashed #e5e7eb; }
    .ticket-tear::after, .ticket-tear > i {
        content: ""; position: absolute; top: 50%; width: 1.25rem; height: 1.25rem; margin-top: -0.625rem;
        border-radius: 999px; background: #f3f4f6;
    }
    .ticket-tear::after { right: -0.625rem; }
    .ticket-tear > i { left: -0.625rem; }
    .ticket-total { padding: 0.25rem 1.25rem 1.25rem; }
    .ticket-total-label { font-size: 0.875rem; color: #6b7280; }
    .total-figure { display: none; font-size: 2.25rem; font-weight: 800; color: #111827; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
    .total-prompt { font-size: 0.9375rem; color: #6b7280; padding-top: 0.25rem; }

    .submit-btn {
        display: flex; justify-content: center; width: 100%; padding: 0.9rem 1.5rem;
        font-size: 1rem; font-weight: 700; color: #fff; background: #b91c1c;
        border: none; border-radius: 0.625rem; cursor: pointer; transition: background .15s;
    }
    .submit-btn:hover { background: #991b1b; }
    .submit-btn:focus-visible { outline: 3px solid #fca5a5; outline-offset: 2px; }

    #problems:focus { outline: 2px solid #b91c1c; outline-offset: 3px; }
    .jump-link { display: inline-block; margin: 0.25rem 0.375rem 0 0; padding: 0.125rem 0.5rem; border: 1px solid #b91c1c; border-radius: 0.375rem; font-weight: 600; text-decoration: none; color: #991b1b; }
    .jump-link:hover { background: #b91c1c; color: #fff; }
    .validation-list ul { list-style: disc; padding-left: 1.15rem; margin: 0; }

    /* ---- What the radio buttons switch on and off ---- */
    .when-family, .when-eft, .when-card, .guardian-block, .extra-person-note { display: none; }
    form:has(#mt-Family:checked) .when-family { display: block; }
    form:has(#mt-Individual:checked) .extra-person-note,
    form:has(#mt-Pensioner:checked) .extra-person-note { display: block; }
    form:has(#pm-EFT:checked) .when-eft { display: block; }
    form:has(#pm-Card:checked) .when-card { display: block; }
    form:has(.junior-box:checked) .guardian-block { display: block; }

    form:has(#mt-Individual:checked) .fee-Individual,
    form:has(#mt-Family:checked) .fee-Family,
    form:has(#mt-Pensioner:checked) .fee-Pensioner,
    form:has(#at-New:checked) .fee-admin,
    form:has(#at-Renewal:checked) .fee-renewal { display: flex; }
    form:has(input[name="Input.MembershipType"]:checked) .prompt-type { display: none; }

    form:has(#mt-Individual:checked):has(#at-New:checked) .total-Individual-New,
    form:has(#mt-Individual:checked):has(#at-Renewal:checked) .total-Individual-Renewal,
    form:has(#mt-Family:checked):has(#at-New:checked) .total-Family-New,
    form:has(#mt-Family:checked):has(#at-Renewal:checked) .total-Family-Renewal,
    form:has(#mt-Pensioner:checked):has(#at-New:checked) .total-Pensioner-New,
    form:has(#mt-Pensioner:checked):has(#at-Renewal:checked) .total-Pensioner-Renewal { display: block; }
    form:has(input[name="Input.MembershipType"]:checked):has(input[name="Input.ApplicationType"]:checked) .total-prompt { display: none; }

    @@media (prefers-reduced-motion: no-preference) {
        .choice, .form-input { transition-duration: .15s; }
    }
</style>

<div class="bg-gray-100 min-h-screen py-8">
    <div class="max-w-6xl mx-auto px-4">

        <header class="mb-6 max-w-3xl">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900">Join or renew your POLK membership</h1>
            @if (year != null)
            {
                <p class="text-gray-600 mt-2 text-lg">
                    Membership for the @year.Name shooting year, @year.StartDate.ToString("d MMMM yyyy") to @year.EndDate.ToString("d MMMM yyyy").
                </p>
            }
        </header>

        @if (year == null)
        {
            <div class="bg-white rounded-xl shadow p-8 max-w-3xl">
                <h2 class="text-xl font-bold text-gray-900 mb-2">Applications aren't open right now</h2>
                <p class="text-gray-600">The membership fees for the coming year haven't been published yet. Please contact the club at <a class="text-red-700 underline" href="mailto:@MembershipService.AccountsEmail">@MembershipService.AccountsEmail</a>.</p>
            </div>
        }
        else
        {
            @* Pinned to the handler-less URL: "Add family member" and "Remove" post to ?handler=…
               and re-render, so a form without an action would keep posting to them. *@
            <form method="post" asp-page="/Apply" novalidate class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] items-start">

                <div class="bg-white rounded-xl shadow p-6 md:p-8 space-y-10">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div id="problems" class="rounded-lg border border-red-300 bg-red-50 p-4" role="alert" tabindex="-1">
                            <p class="font-bold text-red-900">Your application hasn't been submitted yet</p>
                            <p class="text-sm text-red-800 mt-1">Everything you entered has been kept. Fix what's marked below, then submit again.</p>
                            <div asp-validation-summary="ModelOnly" class="validation-list text-sm text-red-800 mt-2"></div>
                            <p class="text-sm text-red-900 mt-2">
                                @if (Model.ErrorCount("Input.ApplicationType") + Model.ErrorCount("Input.MembershipType") > 0) { <a href="#step-membership" class="jump-link">Membership</a> }
                                @for (var n = 0; n < people.Count; n++)
                                {
                                    if (Model.ErrorCount($"Input.People[{n}]") > 0)
                                    {
                                        var who = $"{people[n].FirstName} {people[n].Surname}".Trim();
                                        <a href="#person-@n" class="jump-link">@(string.IsNullOrEmpty(who) ? $"Person {n + 1}" : who)</a>
                                    }
                                }
                                @if (Model.ErrorCount("Input.StreetAddress") + Model.ErrorCount("Input.Suburb") + Model.ErrorCount("Input.City") + Model.ErrorCount("Input.Province") + Model.ErrorCount("Input.PostalCode") > 0) { <a href="#step-address" class="jump-link">Address</a> }
                                @if (Model.ErrorCount("Input.SocialMediaConsent") + Model.ErrorCount("Input.DeclarationAgreed") + Model.ErrorCount("Input.Guardian") > 0) { <a href="#step-declaration" class="jump-link">Declaration</a> }
                                @if (Model.ErrorCount("Input.PaymentMethod") > 0) { <a href="#step-payment" class="jump-link">Payment</a> }
                            </p>
                        </div>
                    }

                    <!-- 1. New or renewal + type -->
                    <section id="step-membership" class="step @(Model.ErrorCount("Input.ApplicationType") + Model.ErrorCount("Input.MembershipType") > 0 ? "step-error" : "")">
                        <div class="step-head"><span class="step-num">1</span><h2 class="step-title">Your membership</h2></div>

                        <fieldset>
                            <legend class="form-label">Is this a new membership or a renewal?</legend>
                            <div class="grid gap-3 sm:grid-cols-2">
                                <label class="choice">
                                    <input type="radio" id="at-New" asp-for="Input.ApplicationType" value="@ApplicationTypes.New" />
                                    <span>
                                        <span class="choice-title block">New member</span>
                                        <span class="choice-text block">You're joining POLK for the first time. Includes the once-off registration and admin fee of @R(year.NewMemberAdminFee).</span>
                                    </span>
                                </label>
                                <label class="choice">
                                    <input type="radio" id="at-Renewal" asp-for="Input.ApplicationType" value="@ApplicationTypes.Renewal" />
                                    <span>
                                        <span class="choice-title block">Renewal</span>
                                        <span class="choice-text block">You were a POLK member before. No admin fee.</span>
                                    </span>
                                </label>
                            </div>
                            <span asp-validation-for="Input.ApplicationType" class="form-error"></span>
                        </fieldset>

                        <fieldset class="mt-6">
                            <legend class="form-label">Membership type</legend>
                            <div class="grid gap-3 sm:grid-cols-3">
                                <label class="choice">
                                    <input type="radio" id="mt-Individual" asp-for="Input.MembershipType" value="@MembershipTypes.Individual" />
                                    <span>
                                        <span class="choice-title block">Individual</span>
                                        <span class="choice-price block">@R(year.IndividualFee)</span>
                                        <span class="choice-text block">One person, for the year</span>
                                    </span>
                                </label>
                                <label class="choice">
                                    <input type="radio" id="mt-Family" asp-for="Input.MembershipType" value="@MembershipTypes.Family" />
                                    <span>
                                        <span class="choice-title block">Family</span>
                                        <span class="choice-price block">@R(year.FamilyFee)</span>
                                        <span class="choice-text block">Two or more people at one address</span>
                                    </span>
                                </label>
                                <label class="choice">
                                    <input type="radio" id="mt-Pensioner" asp-for="Input.MembershipType" value="@MembershipTypes.Pensioner" />
                                    <span>
                                        <span class="choice-title block">Pensioner</span>
                                        <span class="choice-price block">@R(year.PensionerFee)</span>
                                        <span class="choice-text block">One pensioner, for the year</span>
                                    </span>
                                </label>
                            </div>
                            <span asp-validation-for="Input.MembershipType" class="form-error"></span>
                        </fieldset>
                    </section>

                    <!-- 2. People -->
                    <section id="step-people" class="step">
                        <div class="step-head"><span class="step-num">2</span><h2 class="step-title">Who is joining</h2></div>

                        <div class="space-y-5">
                            @for (var i = 0; i < people.Count; i++)
                            {
                                var errs = Model.ErrorCount($"Input.People[{i}]");
                                <div id="person-@i" class="person-card @(errs > 0 ? "person-card-error" : "") step">
                                    <div class="person-head">
                                        <p class="person-title">
                                            Person @(i + 1)
                                            <span class="person-role">@(i == 0 ? "(main contact)" : "")</span>
                                            @if (errs > 0) { <span class="fix-chip">@errs to fix</span> }
                                        </p>
                                        @if (i > 0)
                                        {
                                            <button type="submit" class="link-btn" formaction="/apply?handler=RemovePerson&amp;index=@i" formnovalidate>Remove this person</button>
                                        }
                                    </div>

                                    @if (i > 0)
                                    {
                                        <p class="extra-person-note mb-4 rounded-md bg-amber-50 border border-amber-200 px-3 py-2 text-sm text-amber-900">
                                            Only a family membership covers more than one person. Choose Family above, or remove this person.
                                        </p>
                                    }

                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                        <div>
                                            <label class="form-label" asp-for="Input.People[i].FirstName">First name</label>
                                            <input class="form-input" asp-for="Input.People[i].FirstName" autocomplete="@(i == 0 ? "given-name" : "off")" />
                                            <span asp-validation-for="Input.People[i].FirstName" class="form-error"></span>
                                        </div>
                                        <div>
                                            <label class="form-label" asp-for="Input.People[i].Surname">Surname</label>
                                            <input class="form-input" asp-for="Input.People[i].Surname" autocomplete="@(i == 0 ? "family-name" : "off")" />
                                            <span asp-validation-for="Input.People[i].Surname" class="form-error"></span>
                                        </div>
                                        <div>
                                            <label class="form-label" asp-for="Input.People[i].IdNumber">ID number</label>
                                            <input class="form-input" asp-for="Input.People[i].IdNumber" inputmode="numeric" />
                                            <p class="form-hint">Passport number if you don't have a South African ID.</p>
                                            <span asp-validation-for="Input.People[i].IdNumber" class="form-error"></span>
                                        </div>
                                        <div>
                                            <label class="form-label" asp-for="Input.People[i].Gender">Gender</label>
                                            <select class="form-input" asp-for="Input.People[i].Gender">
                                                <option value="">Choose&hellip;</option>
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                                <option value="Other">Other</option>
                                            </select>
                                            <span asp-validation-for="Input.People[i].Gender" class="form-error"></span>
                                        </div>
                                        <div>
                                            <label class="form-label" asp-for="Input.People[i].ContactNumber">Contact number @if (i > 0) { <span class="optional">(optional)</span> }</label>
                                            <input class="form-input" asp-for="Input.People[i].ContactNumber" type="tel" autocomplete="@(i == 0 ? "tel" : "off")" />
                                            <span asp-validation-for="Input.People[i].ContactNumber" class="form-error"></span>
                                        </div>
                                        <div>
                                            <label class="form-label" asp-for="Input.People[i].EmailAddress">Email address @if (i > 0) { <span class="optional">(optional)</span> }</label>
                                            <input class="form-input" asp-for="Input.People[i].EmailAddress" type="email" autocomplete="@(i == 0 ? "email" : "off")" />
                                            <span asp-validation-for="Input.People[i].EmailAddress" class="form-error"></span>
                                        </div>
                                        <div>
                                            <label class="form-label" asp-for="Input.People[i].SahftaNumber">SAHFTA membership number <span class="optional">(if you have one)</span></label>
                                            <input class="form-input" asp-for="Input.People[i].SahftaNumber" />
                                        </div>
                                        <div class="flex items-end pb-2">
                                            <label class="check">
                                                <input type="checkbox" class="junior-box" asp-for="Input.People[i].IsJunior" />
                                                <span class="text-gray-800">Under 18</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="when-family mt-5">
                            @if (people.Count < ApplyModel.MaxPeople)
                            {
                                <button type="submit" class="ghost-btn" formaction="/apply?handler=AddPerson" formnovalidate>+ Add a family member</button>
                            }
                            <p class="form-hint mt-2">A family membership covers everyone listed here, for one fee.</p>
                        </div>

                        <div class="info-box mt-6">
                            <p class="font-bold text-amber-900">SAHFTA affiliation is optional and paid to SAHFTA</p>
                            <p class="mt-1">Join SAHFTA if you want your scores on the SAHFTA rankings and to shoot national competitions. POLK doesn't collect this fee. Pay SAHFTA directly, then send the proof of payment to both POLK and SAHFTA.</p>
                            <table class="mt-2">
                                <tr><td>Adult</td><td>@R(year.SahftaAdultFee)</td></tr>
                                <tr><td>Junior (under 18)</td><td>@R(year.SahftaJuniorFee)</td></tr>
                            </table>
                            <p class="mt-2 text-sm">SAHFTA confirms its own prices. <a class="underline font-semibold" href="https://sahfta.org.za" target="_blank" rel="noopener">Join or renew at sahfta.org.za</a></p>
                        </div>
                    </section>

                    <!-- 3. Address -->
                    <section id="step-address" class="step">
                        <div class="step-head"><span class="step-num">3</span><h2 class="step-title">Residential address</h2></div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="sm:col-span-2">
                                <label class="form-label" asp-for="Input.StreetAddress">Street address</label>
                                <input class="form-input" asp-for="Input.StreetAddress" autocomplete="address-line1" />
                                <span asp-validation-for="Input.StreetAddress" class="form-error"></span>
                            </div>
                            <div class="sm:col-span-2">
                                <label class="form-label" asp-for="Input.ComplexOrBuilding">Complex or building <span class="optional">(optional)</span></label>
                                <input class="form-input" asp-for="Input.ComplexOrBuilding" autocomplete="address-line2" />
                            </div>
                            <div>
                                <label class="form-label" asp-for="Input.Suburb">Suburb</label>
                                <input class="form-input" asp-for="Input.Suburb" />
                                <span asp-validation-for="Input.Suburb" class="form-error"></span>
                            </div>
                            <div>
                                <label class="form-label" asp-for="Input.City">City or town</label>
                                <input class="form-input" asp-for="Input.City" autocomplete="address-level2" />
                                <span asp-validation-for="Input.City" class="form-error"></span>
                            </div>
                            <div>
                                <label class="form-label" asp-for="Input.Province">Province</label>
                                <select class="form-input" asp-for="Input.Province">
                                    <option value="">Choose&hellip;</option>
                                    @foreach (var p in ApplyModel.Provinces)
                                    {
                                        <option value="@p">@p</option>
                                    }
                                </select>
                                <span asp-validation-for="Input.Province" class="form-error"></span>
                            </div>
                            <div>
                                <label class="form-label" asp-for="Input.PostalCode">Postal code</label>
                                <input class="form-input" asp-for="Input.PostalCode" inputmode="numeric" autocomplete="postal-code" />
                                <span asp-validation-for="Input.PostalCode" class="form-error"></span>
                            </div>
                        </div>
                    </section>

                    <!-- 4. Declaration -->
                    <section id="step-declaration" class="step @(Model.ErrorCount("Input.SocialMediaConsent") + Model.ErrorCount("Input.DeclarationAgreed") + Model.ErrorCount("Input.Guardian") > 0 ? "step-error" : "")">
                        <div class="step-head"><span class="step-num">4</span><h2 class="step-title">Declaration</h2></div>

                        <ul class="legal-box list-disc pl-8">
                            <li>I acknowledge and understand that Field Target Shooting may potentially be a dangerous sport, and declare that my participation is wholly at my own risk.</li>
                            <li>I agree to abide by the club's constitution and rules.</li>
                            <li>I agree to familiarise myself with the SAHFTA Rules and Regulations.</li>
                            <li>I indemnify the Pretoria East Airgun Field Target Club, its members, office bearers, or any other person representing the club from any blame.</li>
                            <li>I surrender my rights to any claim whatsoever that may arise out of action or neglect of any of the persons mentioned here.</li>
                        </ul>

                        <label class="check mt-4">
                            <input type="checkbox" asp-for="Input.DeclarationAgreed" />
                            <span class="text-gray-900 font-medium">I accept this declaration for myself@(people.Count > 1 ? " and the people on this application" : "").</span>
                        </label>
                        <span asp-validation-for="Input.DeclarationAgreed" class="form-error"></span>

                        <fieldset class="mt-6">
                            <legend class="form-label">May photos of you@(people.Count > 1 ? " and your family" : "") taken at club events be published on social media or used in marketing material?</legend>
                            <div class="grid gap-3 sm:grid-cols-2">
                                <label class="choice">
                                    <input type="radio" asp-for="Input.SocialMediaConsent" value="yes" />
                                    <span class="choice-title">Yes, they may be published</span>
                                </label>
                                <label class="choice">
                                    <input type="radio" asp-for="Input.SocialMediaConsent" value="no" />
                                    <span class="choice-title">No, please don't publish them</span>
                                </label>
                            </div>
                            <span asp-validation-for="Input.SocialMediaConsent" class="form-error"></span>
                        </fieldset>

                        <div class="guardian-block mt-6 rounded-lg border border-gray-200 p-4">
                            <p class="font-semibold text-gray-900">Parent or legal guardian</p>
                            <p class="form-hint mb-3">Someone on this application is under 18, so a parent or legal guardian must accept the declaration for them.</p>
                            <label class="form-label" asp-for="Input.GuardianName">Parent or guardian's full name</label>
                            <input class="form-input" asp-for="Input.GuardianName" />
                            <span asp-validation-for="Input.GuardianName" class="form-error"></span>
                            <label class="check mt-3">
                                <input type="checkbox" asp-for="Input.GuardianConsent" />
                                <span class="text-gray-900">I am the parent or legal guardian and I accept the declaration on behalf of the members under 18.</span>
                            </label>
                            <span asp-validation-for="Input.GuardianConsent" class="form-error"></span>
                        </div>
                    </section>

                    <!-- 5. Payment -->
                    <section id="step-payment" class="step @(Model.ErrorCount("Input.PaymentMethod") > 0 ? "step-error" : "")">
                        <div class="step-head"><span class="step-num">5</span><h2 class="step-title">How you'll pay</h2></div>
                        <div class="grid gap-3 sm:grid-cols-2">
                            <label class="choice">
                                <input type="radio" id="pm-Card" asp-for="Input.PaymentMethod" value="Card" />
                                <span>
                                    <span class="choice-title block">Card, online now</span>
                                    <span class="choice-text block">You'll go to a secure payment page after submitting.</span>
                                </span>
                            </label>
                            <label class="choice">
                                <input type="radio" id="pm-EFT" asp-for="Input.PaymentMethod" value="EFT" />
                                <span>
                                    <span class="choice-title block">EFT (bank transfer)</span>
                                    <span class="choice-text block">Pay from your bank and email us the proof of payment.</span>
                                </span>
                            </label>
                        </div>
                        <span asp-validation-for="Input.PaymentMethod" class="form-error"></span>

                        <div class="when-eft mt-4 bank-box">
                            <p class="font-semibold text-gray-900 mb-2">Bank details</p>
                            <dl class="grid grid-cols-[8rem_1fr] gap-y-1">
                                <dt>Account name</dt><dd>@Model.Bank.AccountName</dd>
                                <dt>Bank</dt><dd>@Model.Bank.BankName</dd>
                                <dt>Account number</dt><dd>@Model.Bank.AccountNumber</dd>
                                <dt>Branch code</dt><dd>@Model.Bank.BranchCode</dd>
                            </dl>
                            <p class="form-hint mt-2">You'll get your payment reference after submitting. Send the proof of payment to @Model.Bank.ProofOfPaymentEmail.</p>
                        </div>
                    </section>
                </div>

                <!-- The ticket -->
                <aside class="lg:sticky lg:top-6 space-y-4" aria-label="Amount due">
                    <div class="ticket">
                        <div class="ticket-head">
                            <p class="ticket-club">POLK membership</p>
                            <p class="ticket-year">@year.Name</p>
                            <p class="ticket-dates">@year.StartDate.ToString("d MMM yyyy") to @year.EndDate.ToString("d MMM yyyy")</p>
                        </div>
                        <div class="ticket-body">
                            <div class="ticket-row fee-Individual"><span>Individual membership</span><span>@R(year.IndividualFee)</span></div>
                            <div class="ticket-row fee-Family"><span>Family membership</span><span>@R(year.FamilyFee)</span></div>
                            <div class="ticket-row fee-Pensioner"><span>Pensioner membership</span><span>@R(year.PensionerFee)</span></div>
                            <div class="ticket-row muted always prompt-type"><span>Membership type not chosen yet</span><span></span></div>
                            <div class="ticket-row fee-admin"><span>Once-off admin fee</span><span>@R(year.NewMemberAdminFee)</span></div>
                            <div class="ticket-row muted fee-renewal"><span>Admin fee</span><span>Not charged</span></div>
                        </div>
                        <div class="ticket-tear" aria-hidden="true"><i></i></div>
                        <div class="ticket-total">
                            <p class="ticket-total-label">Total due</p>
                            @foreach (var t in MembershipTypes.All)
                            {
                                foreach (var a in new[] { ApplicationTypes.New, ApplicationTypes.Renewal })
                                {
                                    <p class="total-figure total-@t-@a">@R(MembershipService.Price(year, t, a).Total)</p>
                                }
                            }
                            <p class="total-prompt">Choose new or renewal and a membership type to see your total.</p>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn">Submit application</button>
                    <p class="text-xs text-gray-500 when-card">After submitting you'll go to the secure card payment page.</p>
                    <p class="text-xs text-gray-500 when-eft">After submitting you'll see the payment reference to use. We'll email it to you as well.</p>
                </aside>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        // A rejected submit re-renders from the top. Bring the list of problems into view and
        // focus it, so it is announced as well as seen. Nothing else on this page uses script.
        (function () {
            var problems = document.getElementById('problems');
            if (!problems) return;
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            problems.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
            problems.focus({ preventScroll: true });
        })();
    </script>
}
