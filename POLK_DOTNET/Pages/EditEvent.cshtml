@page "/editevent/{id:int}"
@model POLK_DOTNET.Pages.EditEventModel
@{
    ViewData["Title"] = "Edit Event";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jodit@4/es2021/jodit.min.css" />
<script src="https://cdn.jsdelivr.net/npm/jodit@4/es2021/jodit.min.js"></script>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8">Edit Event</h1>

    <form method="post" class="space-y-6">
        <div asp-validation-summary="All" class="text-red-600 font-semibold mb-4"></div>
        <input type="hidden" asp-for="Event.Id" />

        <fieldset class="border p-4 rounded-md space-y-4">
            <legend class="text-lg font-semibold px-2">Event Details</legend>

            <input type="text" asp-for="Event.Title" class="w-full px-4 py-2 border rounded-md" placeholder="Title" required />
            <div>
                <label asp-for="Event.StartDate" class="block text-sm font-medium text-gray-700">Start Date</label>
                <input type="date" asp-for="Event.StartDate" class="w-full px-4 py-2 border rounded-md" required />
            </div>
            <div>
                <label asp-for="Event.EndDate" class="block text-sm font-medium text-gray-700">End Date (optional)</label>
                <input type="date" asp-for="Event.EndDate" class="w-full px-4 py-2 border rounded-md" />
            </div>
            <input type="text" asp-for="Event.Time" class="w-full px-4 py-2 border rounded-md" placeholder="Time" required />
            <input type="text" asp-for="Event.Type" class="w-full px-4 py-2 border rounded-md" placeholder="Type" required />
            <div>
                <label asp-for="Event.Description" class="block text-sm font-medium text-gray-700 mb-1">Event Description</label>
                <textarea asp-for="Event.Description" id="event-description" rows="10" class="w-full px-4 py-2 border rounded-md"></textarea>
                <p class="text-xs text-gray-500 mt-1">Use the toolbar to format. Appears on the registration page and upcoming-events list.</p>
            </div>
            <input type="text" asp-for="Event.Location" class="w-full px-4 py-2 border rounded-md" placeholder="Location" />
            <input type="number" asp-for="Event.Participants" class="w-full px-4 py-2 border rounded-md" placeholder="Participants" />
            <input type="number" asp-for="Event.MaxParticipants" class="w-full px-4 py-2 border rounded-md" placeholder="Max Participants" />
            <select asp-for="Event.Color" class="w-full px-4 py-2 border rounded-md">
                <option value="">Select a color...</option>
                <option value="bg-red-500" class="bg-red-500 text-white">Red</option>
                <option value="bg-blue-500" class="bg-blue-500 text-white">Blue</option>
                <option value="bg-green-500" class="bg-green-500 text-white">Green</option>
                <option value="bg-yellow-500" class="bg-yellow-500 text-black">Yellow</option>
                <option value="bg-indigo-500" class="bg-indigo-500 text-white">Indigo</option>
                <option value="bg-purple-500" class="bg-purple-500 text-white">Purple</option>
                <option value="bg-pink-500" class="bg-pink-500 text-white">Pink</option>
                <option value="bg-gray-700" class="bg-gray-700 text-white">Gray</option>
                <option value="bg-teal-500" class="bg-teal-500 text-white">Teal</option>
                <option value="bg-orange-500" class="bg-orange-500 text-white">Orange</option>
            </select>
            <div class="flex items-center">
                <input type="checkbox" asp-for="Event.IsClubEvent" class="h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300 rounded" />
                <label asp-for="Event.IsClubEvent" class="ml-2 block text-sm text-gray-900">Is Our Club Event</label>
            </div>
        </fieldset>

        <fieldset class="border p-4 rounded-md space-y-4">
            <legend class="text-lg font-semibold px-2">Registration Settings</legend>

            <div class="flex items-center">
                <input type="checkbox" asp-for="Event.IsRegistrationOpen" class="h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300 rounded" />
                <label asp-for="Event.IsRegistrationOpen" class="ml-2 block text-sm text-gray-900 font-semibold">Registration is Open</label>
            </div>

            @if (Model.Event.IsRegistrationOpen)
            {
                var regUrl = $"{Request.Scheme}://{Request.Host}/RegisterEvent/{Model.Event.Id}";
                <div class="p-3 bg-green-50 border border-green-200 rounded-md">
                    <p class="text-sm font-medium text-green-900 mb-1">Share this registration link:</p>
                    <div class="flex items-center gap-2">
                        <a href="@regUrl" target="_blank" class="text-sm text-blue-700 hover:underline break-all">@regUrl</a>
                        <button type="button" onclick="copyRegUrl(this, '@regUrl')" class="text-xs px-3 py-1 bg-white border hover:bg-gray-100 rounded whitespace-nowrap">Copy</button>
                    </div>
                </div>
                <script>
                    function copyRegUrl(btn, url) {
                        navigator.clipboard.writeText(url).then(function () {
                            var original = btn.textContent;
                            btn.textContent = 'Copied!';
                            setTimeout(function () { btn.textContent = original; }, 1500);
                        });
                    }
                </script>
            }

            <div>
                <label asp-for="Event.RegistrationCloseDate" class="block text-sm font-medium text-gray-700">Registration Close Date (optional)</label>
                <input type="date" asp-for="Event.RegistrationCloseDate" class="w-full px-4 py-2 border rounded-md" />
            </div>

            <div>
                <label asp-for="Event.EventType" class="block text-sm font-medium text-gray-700">Event Type</label>
                <select asp-for="Event.EventType" class="w-full px-4 py-2 border rounded-md">
                    <option value="HFT">HFT</option>
                    <option value="Benchrest">Benchrest</option>
                    <option value="Other">Other</option>
                </select>
                <p class="text-xs text-gray-500 mt-1">Determines rifle type options on the registration form.</p>
            </div>

            <div class="flex items-center">
                <input type="checkbox" asp-for="Event.IsLeagueShoot" class="h-4 w-4 rounded" />
                <label asp-for="Event.IsLeagueShoot" class="ml-2 text-sm">This is a League shoot (enables Troyer course setup)</label>
            </div>

            <div class="flex items-center">
                <input type="checkbox" asp-for="Event.IsDoubleHeader" class="h-4 w-4 rounded" />
                <label asp-for="Event.IsDoubleHeader" class="ml-2 text-sm">Double Header (two league shoots on the day)</label>
            </div>

            <div class="flex items-center pl-6">
                <input type="checkbox" asp-for="Event.UseSameCourseForBothShoots" class="h-4 w-4 rounded" />
                <label asp-for="Event.UseSameCourseForBothShoots" class="ml-2 text-sm">Use the same course for both shoots</label>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Event.EntryFee" class="block text-sm font-medium text-gray-700">Entry Fee (R) — single shoot</label>
                    <input type="number" step="0.01" asp-for="Event.EntryFee" class="w-full px-4 py-2 border rounded-md" placeholder="e.g. 30.00" />
                </div>
                <div>
                    <label asp-for="Event.EntryFeeDescription" class="block text-sm font-medium text-gray-700">Entry Fee Description</label>
                    <input type="text" asp-for="Event.EntryFeeDescription" class="w-full px-4 py-2 border rounded-md" placeholder="e.g. per target sheet" />
                </div>
            </div>

            <div>
                <label asp-for="Event.DoubleHeaderFee" class="block text-sm font-medium text-gray-700">Double Header Fee (R) — both shoots</label>
                <input type="number" step="0.01" asp-for="Event.DoubleHeaderFee" class="w-full px-4 py-2 border rounded-md" placeholder="Leave blank for 2 x single-shoot fee" />
                <p class="text-xs text-gray-500 mt-1">Only used when Double Header is checked. If left blank, the cost for both shoots is twice the single-shoot fee.</p>
            </div>

            <div class="space-y-2">
                <p class="text-sm font-medium text-gray-700">Which sections to show on the registration form:</p>
                <div class="flex items-center">
                    <input type="checkbox" asp-for="Event.RequiresAttendanceType" class="h-4 w-4 rounded" />
                    <label asp-for="Event.RequiresAttendanceType" class="ml-2 text-sm">Competitor / Spectator choice</label>
                </div>
                <div class="flex items-center">
                    <input type="checkbox" asp-for="Event.RequiresSahfta" class="h-4 w-4 rounded" />
                    <label asp-for="Event.RequiresSahfta" class="ml-2 text-sm">SAHFTA Number field</label>
                </div>
                <div class="flex items-center">
                    <input type="checkbox" asp-for="Event.RequiresClubName" class="h-4 w-4 rounded" />
                    <label asp-for="Event.RequiresClubName" class="ml-2 text-sm">Club Name field</label>
                </div>
                <div class="flex items-center">
                    <input type="checkbox" asp-for="Event.RequiresDivision" class="h-4 w-4 rounded" />
                    <label asp-for="Event.RequiresDivision" class="ml-2 text-sm">Division (Open PCP / Ladies / U18 / U13 / Other)</label>
                </div>
                <div class="flex items-center">
                    <input type="checkbox" asp-for="Event.AllowsClubRifle" class="h-4 w-4 rounded" />
                    <label asp-for="Event.AllowsClubRifle" class="ml-2 text-sm">Offer "use club air-rifle" option</label>
                </div>
            </div>

            <div>
                <label asp-for="Event.BankingDetailsHtml" class="block text-sm font-medium text-gray-700">Banking / Payment Instructions (HTML, optional)</label>
                <textarea asp-for="Event.BankingDetailsHtml" rows="4" class="w-full px-4 py-2 border rounded-md" placeholder="EFT details, card machine note, etc."></textarea>
            </div>

            <div class="flex items-center">
                <input type="checkbox" asp-for="Event.EnableYocoPayment" class="h-4 w-4 rounded" />
                <label asp-for="Event.EnableYocoPayment" class="ml-2 text-sm">Enable Yoco online payment</label>
            </div>

            <div>
                <label asp-for="Event.NotificationEmail" class="block text-sm font-medium text-gray-700">Notification Email (optional)</label>
                <input type="email" asp-for="Event.NotificationEmail" class="w-full px-4 py-2 border rounded-md" placeholder="e.g. ajaneke.polk@gmail.com" />
                <p class="text-xs text-gray-500 mt-1">If set, new registrations and payment notifications go here instead of accounts@polk-hft.co.za.</p>
            </div>
        </fieldset>

        <button type="submit" class="px-4 py-2 text-white bg-red-700 rounded-md">Save Changes</button>
    </form>
</div>

<script>
    (function () {
        const el = document.getElementById('event-description');
        if (el && typeof Jodit !== 'undefined') {
            Jodit.make(el, {
                height: 360,
                toolbarButtonSize: 'middle',
                buttons: 'paragraph,bold,italic,underline,strikethrough,|,ul,ol,|,outdent,indent,|,font,fontsize,brush,|,align,|,link,image,table,hr,|,undo,redo,|,source,fullsize',
                uploader: { insertImageAsBase64URI: true }
            });
        }
    })();
</script>
