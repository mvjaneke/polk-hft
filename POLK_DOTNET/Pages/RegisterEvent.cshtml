@page "{eventId:int}"
@model POLK_DOTNET.Pages.RegisterEventModel
@{
    ViewData["Title"] = "Register for Event";
    var ev = Model.Event;
    var benchrest = ev.EventType == "Benchrest";
    var singleFee = ev.EntryFee ?? 0m;
    var bothFee = ev.DoubleHeaderFee ?? singleFee * 2;
    var mealsOn = ev.MealsChargeable;
    var chargesAnything = singleFee > 0 || mealsOn;
}

<style>
    .form-input {
        display: block;
        width: 100%;
        padding: 0.625rem 0.875rem;
        font-size: 1rem;
        line-height: 1.5;
        color: #111827;
        background-color: #fff;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
        transition: border-color .15s, box-shadow .15s;
    }
    .form-input:focus {
        outline: none;
        border-color: #b91c1c;
        box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.15);
    }
    .form-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.375rem;
    }
    .form-hint {
        font-size: 0.75rem;
        color: #6b7280;
        margin-top: 0.25rem;
    }
    .form-error {
        font-size: 0.8125rem;
        color: #b91c1c;
        margin-top: 0.25rem;
        display: block;
    }
    .section-heading {
        font-size: 1.125rem;
        font-weight: 700;
        color: #111827;
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
        border-bottom: 2px solid #b91c1c;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .option-tile {
        display: flex;
        align-items: flex-start;
        gap: 0.625rem;
        padding: 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all .15s;
        background: #fff;
    }
    .option-tile:hover {
        border-color: #b91c1c;
        background: #fef2f2;
    }
    .option-tile input[type=radio],
    .option-tile input[type=checkbox] {
        margin-top: 0.125rem;
        accent-color: #b91c1c;
        width: 1rem;
        height: 1rem;
    }
    .legal-box {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
        font-size: 0.8125rem;
        color: #374151;
        line-height: 1.55;
    }
    .legal-box p { margin-bottom: 0.5rem; }
    .legal-box p:last-child { margin-bottom: 0; }
    .submit-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        padding: 0.875rem 1.5rem;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        color: #fff;
        background: #b91c1c;
        border-radius: 0.5rem;
        box-shadow: 0 4px 10px rgba(185, 28, 28, 0.25);
        transition: all .15s;
        border: none;
        cursor: pointer;
    }
    .submit-btn:hover { background: #991b1b; box-shadow: 0 6px 14px rgba(185, 28, 28, 0.35); }

    .person-card {
        border: 1px solid #e5e7eb;
        border-left: 4px solid #b91c1c;
        border-radius: 0.75rem;
        background: #fff;
        padding: 1.25rem;
    }
    .person-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
        padding-bottom: 0.625rem;
        border-bottom: 1px solid #f3f4f6;
    }
    .person-title { font-size: 1rem; font-weight: 700; color: #111827; }
    .link-btn {
        background: none;
        border: none;
        padding: 0;
        font-size: 0.8125rem;
        color: #b91c1c;
        text-decoration: underline;
        cursor: pointer;
    }
    .ghost-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.125rem;
        font-size: 0.9375rem;
        font-weight: 600;
        color: #b91c1c;
        background: #fff;
        border: 1px dashed #b91c1c;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: background .15s;
    }
    .ghost-btn:hover { background: #fef2f2; }

    /* Failure state. The card language already carries a red left rule, so a person with
       problems deepens that rule and tints the block rather than introducing a new device. */
    .person-card-error {
        border-color: #fca5a5;
        border-left-width: 6px;
        background: #fffbfb;
    }
    .fix-chip {
        display: inline-block;
        margin-left: 0.5rem;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        background: #b91c1c;
        color: #fff;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        vertical-align: 0.1em;
    }
    .validation-list ul { list-style: disc; padding-left: 1.15rem; margin: 0; }
    .validation-list li { margin-top: 0.125rem; }
    .jump-link {
        display: inline-block;
        margin: 0.25rem 0.375rem 0 0;
        padding: 0.125rem 0.5rem;
        border: 1px solid #b91c1c;
        border-radius: 0.375rem;
        font-weight: 600;
        text-decoration: none;
    }
    .jump-link:hover { background: #b91c1c; color: #fff; }
    #problems:focus { outline: 2px solid #b91c1c; outline-offset: 3px; }
    :target { scroll-margin-top: 5rem; }

    /* Spectators don't shoot — hide the competition-only fields for that person only.
       Scoped to the person's own card so one spectator doesn't hide everyone's fields.
       Hidden required inputs are skipped by jQuery validation's default ignore:":hidden". */
    .spectator-note { display: none; }
    .person-card:has(input[value="Spectator"]:checked) .competitor-only { display: none; }
    .person-card:has(input[value="Spectator"]:checked) .spectator-note { display: block; }
</style>

<div class="min-h-screen bg-gray-100 py-8">
    <div class="max-w-3xl mx-auto px-4">

        <!-- Event hero -->
        <div class="bg-gradient-to-r from-red-700 to-red-900 rounded-xl shadow-lg p-6 mb-6 text-white">
            <p class="text-sm uppercase tracking-wider text-red-200 mb-1">Event Registration</p>
            <h1 class="text-3xl md:text-4xl font-bold">@ev.Title</h1>
            <p class="text-red-100 mt-2">
                @if (ev.IsProvincialTwoDay && ev.EndDate.HasValue)
                {
                    <span class="inline-block mr-4">📅 @ev.StartDate.ToString("ddd, dd MMM yyyy") &ndash; @ev.EndDate.Value.ToString("ddd, dd MMM yyyy")</span>
                }
                else
                {
                    <span class="inline-block mr-4">📅 @ev.StartDate.ToString("dddd, dd MMMM yyyy")</span>
                }
                <span class="inline-block mr-4">🕐 @ev.Time</span>
                @if (!string.IsNullOrWhiteSpace(ev.Location))
                {
                    <span class="inline-block">📍 @ev.Location</span>
                }
            </p>
            @if (ev.IsProvincialTwoDay)
            {
                <p class="mt-3 inline-block bg-white/15 rounded px-3 py-1 text-sm font-semibold">
                    Provincial event &middot; shot over two days &mdash; your entry covers both days
                </p>
            }
        </div>

        <!-- Main card -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">

            @if (!string.IsNullOrWhiteSpace(ev.Description))
            {
                <div class="p-6 border-b bg-gray-50 prose max-w-none text-sm">
                    @Html.Raw(ev.Description)
                </div>
            }

            @if (chargesAnything)
            {
                <div class="p-4 bg-amber-50 border-b border-amber-200 flex items-start gap-3">
                    <span class="text-2xl">💰</span>
                    <div>
                        @if (singleFee > 0)
                        {
                            @if (ev.IsDoubleHeader)
                            {
                                <strong class="text-amber-900">Entry Fees:</strong>
                                <span class="text-amber-900 text-lg font-semibold">@($"R{singleFee:F2}") per shoot</span>
                                <span class="text-amber-900 text-lg font-semibold">&middot; @($"R{bothFee:F2}") both shoots</span>
                            }
                            else
                            {
                                <strong class="text-amber-900">Entry Fee:</strong>
                                <span class="text-amber-900 text-lg font-semibold">@($"R{singleFee:F2}")</span>
                                <span class="text-amber-800 text-sm">per competitor@(ev.IsProvincialTwoDay ? ", covering both days" : "")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(ev.EntryFeeDescription))
                            {
                                <span class="text-amber-800 text-sm">(@ev.EntryFeeDescription)</span>
                            }
                        }
                        @if (ev.AllowsClubRifle && ev.ClubRifleFee.HasValue && ev.ClubRifleFee.Value > 0)
                        {
                            <p class="text-xs text-amber-800 mt-1">+@($"R{ev.ClubRifleFee.Value:F2}") per person needing a club air-rifle and pellets.</p>
                        }
                        @if (mealsOn)
                        {
                            <p class="text-xs text-amber-800 mt-1">
                                @(string.IsNullOrWhiteSpace(ev.MealDescription) ? "Meals" : ev.MealDescription):
                                <strong>@($"R{ev.MealFee!.Value:F2}")</strong> each &mdash; book as many as you need below, for spectators and family too.
                            </p>
                        }
                        <p class="text-xs text-amber-800 mt-1">Spectators pay no entry fee. One booking can cover several people; the total is confirmed on the next screen and by email.</p>
                    </div>
                </div>
            }

            @if (Model.RegistrationClosed)
            {
                <div class="p-8 text-center">
                    <div class="text-5xl mb-3">🚫</div>
                    <h2 class="text-xl font-bold text-gray-900 mb-2">Registration Closed</h2>
                    <p class="text-gray-600">Registration for this event is no longer available.</p>
                </div>
            }
            else
            {
                @* The action is pinned to the handler-less page URL on purpose. "Add another person"
                   and "Remove" post to ?handler=…, and because they re-render rather than redirect,
                   the address bar keeps that query string. A form with no action inherits the current
                   URL, so every later submit — including this one — would post to AddParticipant and
                   just grow another empty person block. *@
                <form method="post" asp-page="/RegisterEvent" asp-route-eventId="@Model.EventId" class="p-6 md:p-8 space-y-8">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div id="problems" class="rounded-lg border border-red-300 bg-red-50 p-4" role="alert" tabindex="-1">
                            <p class="font-bold text-red-900">Registration not submitted</p>
                            <p class="text-sm text-red-800 mt-1">
                                Everything you filled in has been kept. Fix what is marked below, then submit again.
                            </p>

                            @* Model-level problems only. Field problems are marked in place, and the
                               links below lead straight to them — repeating all of them here turns a
                               twelve-person booking into a wall of text nobody reads. *@
                            <div asp-validation-summary="ModelOnly" class="validation-list text-sm text-red-800 mt-2"></div>

                            @{
                                var flaggedPeople = Enumerable.Range(0, Model.Booking.Participants.Count)
                                    .Where(n => Model.ErrorCountFor(n) > 0)
                                    .ToList();
                                var anyAnchors = Model.ContactErrorCount > 0 || flaggedPeople.Count > 0
                                    || Model.MealsErrorCount > 0 || Model.PaymentErrorCount > 0;
                            }
                            @if (anyAnchors)
                            {
                                <p class="text-sm text-red-900 mt-3">
                                    Needs attention:
                                    @if (Model.ContactErrorCount > 0)
                                    {
                                        <a href="#contact" class="jump-link">Booking contact</a>
                                    }
                                    @foreach (var n in flaggedPeople)
                                    {
                                        var pp = Model.Booking.Participants[n];
                                        var who = string.IsNullOrWhiteSpace(pp.Name) && string.IsNullOrWhiteSpace(pp.Surname)
                                            ? $"Person {n + 1}"
                                            : $"{pp.Name} {pp.Surname}".Trim();
                                        <a href="#person-@n" class="jump-link">@who</a>
                                    }
                                    @if (Model.MealsErrorCount > 0)
                                    {
                                        <a href="#meals" class="jump-link">Meals</a>
                                    }
                                    @if (Model.PaymentErrorCount > 0)
                                    {
                                        <a href="#payment" class="jump-link">Payment</a>
                                    }
                                </p>
                            }
                        </div>
                    }

                    <input type="hidden" asp-for="EventId" />

                    <!-- Contact / payer -->
                    <section id="contact">
                        <h2 class="section-heading">Booking Contact</h2>
                        <p class="text-sm text-gray-600 mb-4">
                            The person making this booking and paying for it. If you are also shooting, add yourself as the first person below.
                        </p>

                        <div class="space-y-4">
                            <div>
                                <label asp-for="Booking.EmailAddress" class="form-label">Email Address <span class="text-red-600">*</span></label>
                                <input asp-for="Booking.EmailAddress" type="email" class="form-input" placeholder="you@example.com" />
                                <p class="form-hint">Confirmation and payment instructions for the whole booking go to this address.</p>
                                <span asp-validation-for="Booking.EmailAddress" class="form-error"></span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="Booking.Name" class="form-label">First Name <span class="text-red-600">*</span></label>
                                    <input asp-for="Booking.Name" class="form-input" />
                                    <span asp-validation-for="Booking.Name" class="form-error"></span>
                                </div>
                                <div>
                                    <label asp-for="Booking.Surname" class="form-label">Surname <span class="text-red-600">*</span></label>
                                    <input asp-for="Booking.Surname" class="form-input" />
                                    <span asp-validation-for="Booking.Surname" class="form-error"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="Booking.IdNumber" class="form-label">ID Number <span class="text-red-600">*</span></label>
                                    <input asp-for="Booking.IdNumber" class="form-input" />
                                    <span asp-validation-for="Booking.IdNumber" class="form-error"></span>
                                </div>
                                <div>
                                    <label asp-for="Booking.CellNumber" class="form-label">Contact Number <span class="text-red-600">*</span></label>
                                    <input asp-for="Booking.CellNumber" class="form-input" placeholder="082 123 4567" />
                                    <span asp-validation-for="Booking.CellNumber" class="form-error"></span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Declarations, shown once and signed per person below -->
                    <section>
                        <h2 class="section-heading">Indemnity &amp; Media Release</h2>
                        <p class="text-sm text-gray-600 mb-4">
                            Please read both declarations. <strong>Each person on this booking signs for themselves</strong> in their own block below &mdash; a parent or guardian signs on behalf of anyone under 18.
                        </p>

                        <p class="font-semibold text-gray-700 mb-2">Indemnity Declaration</p>
                        <div class="legal-box mb-5">
                            <p>I hereby declare and certify that:</p>
                            <p>1.&nbsp; I am aware that field target and / or any other shooting is a potentially dangerous sport and that I will obey the safety rules and regulations as explained to me at the shooter's briefing.</p>
                            <p>2.&nbsp; I voluntarily and out of free will choose to participate in the activities hosted by Pretoria East Air-Gun Club / Shooting Range.</p>
                            <p>3.&nbsp; My participation in the presence at said activities / premises is conducted upon my exclusive and sole liability and risk and with the acceptance of any and all effects and results including any damages that may occur, and / or to the suffered, from whatever cause.</p>
                            <p>4.&nbsp; I herewith unconditionally, irrevocably and in its entirety, in consequence of my aforesaid participation and / or presence:</p>
                            <p class="ml-4">4.1&nbsp; Indemnify the said club and / or its officers, staff members, participants, guests and supporters of any liability or claim in consequence of negligence and / or intention of whatever kind;</p>
                            <p class="ml-4">4.2&nbsp; Without any reservation whatsoever, surrender and renounce any claim, right, demand or action against any party.</p>
                            <p>5.&nbsp; This indemnity and renouncement have been thoroughly read and studied before it has been signed by me. I confirm that the content hereof has been properly understood before it was signed, out of free will and without any influence, duress or manipulation.</p>
                        </div>

                        <p class="font-semibold text-gray-700 mb-2">Website &amp; Social Media Release</p>
                        <div class="legal-box">
                            <p>I hereby declare and certify that:</p>
                            <p>1.&nbsp; I understand and here grant permission to Pretoria Oos Luggeweer Klub / Pretoria East Airrifle Club to post my and / or my child's story, photo, or other item (e.g. Video), hereinafter referred to as "Materials" (The only items allowed to use will be in respect of Photos, Videos and at most announcements, in no way will any personal information like ID numbers, email addresses, contact details, or addresses be disclosed). I submit to and for all of Pretoria Oos Luggeweer Klub / Pretoria East Airrifle Club's social media platforms.</p>
                            <p>2.&nbsp; I hereby release you, your representative, employees, managers, members, officers, parent companies, subsidiaries and directors, from all claims and demands arising out of or in connection with any use of said "Materials".</p>
                            <p>3.&nbsp; I acknowledge and agree that no sums whatsoever will be due to me as a result of the use of the "Materials" or any rights therein.</p>
                            <p>4.&nbsp; I acknowledge that my child is under 18 years of age and lack the legal capacity to enter into binding agreements. Accordingly, I read this release and consent to my child's inclusion in the "Materials" and will not contest the rights granted in this release.</p>
                        </div>
                    </section>

                    <!-- People on this booking -->
                    <section>
                        <h2 class="section-heading">Who Is Attending</h2>
                        <p class="text-sm text-gray-600 mb-4">
                            Add everyone this booking covers &mdash; competitors and spectators. Each person needs their own details and signatures.
                        </p>

                        <div class="space-y-6">
                            @for (int i = 0; i < Model.Booking.Participants.Count; i++)
                            {
                                var p = Model.Booking.Participants[i];
                                var label = string.IsNullOrWhiteSpace(p.Name) && string.IsNullOrWhiteSpace(p.Surname)
                                    ? $"Person {i + 1}"
                                    : $"{p.Name} {p.Surname}".Trim();
                                var personErrors = Model.ErrorCountFor(i);

                                <div class="person-card@(personErrors > 0 ? " person-card-error" : "")" id="person-@i">
                                    <div class="person-head">
                                        <span class="person-title">
                                            @label
                                            @if (personErrors > 0)
                                            {
                                                <span class="fix-chip">@personErrors to fix</span>
                                            }
                                        </span>
                                        @if (Model.Booking.Participants.Count > 1)
                                        {
                                            <button type="submit" asp-page-handler="RemoveParticipant" name="index" value="@i" formnovalidate class="link-btn">Remove this person</button>
                                        }
                                    </div>

                                    <div class="space-y-4">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <div>
                                                <label asp-for="Booking.Participants[i].Name" class="form-label">First Name <span class="text-red-600">*</span></label>
                                                <input asp-for="Booking.Participants[i].Name" class="form-input" />
                                                <span asp-validation-for="Booking.Participants[i].Name" class="form-error"></span>
                                            </div>
                                            <div>
                                                <label asp-for="Booking.Participants[i].Surname" class="form-label">Surname <span class="text-red-600">*</span></label>
                                                <input asp-for="Booking.Participants[i].Surname" class="form-input" />
                                                <span asp-validation-for="Booking.Participants[i].Surname" class="form-error"></span>
                                            </div>
                                        </div>

                                        <div>
                                            <label asp-for="Booking.Participants[i].IdNumber" class="form-label">ID Number <span class="text-red-600">*</span></label>
                                            <input asp-for="Booking.Participants[i].IdNumber" class="form-input" />
                                            <span asp-validation-for="Booking.Participants[i].IdNumber" class="form-error"></span>
                                        </div>

                                        @if (ev.RequiresAttendanceType)
                                        {
                                            <div>
                                                <label class="form-label">Attendance <span class="text-red-600">*</span></label>
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                                    <label class="option-tile">
                                                        <input type="radio" asp-for="Booking.Participants[i].AttendanceType" value="Competitor" />
                                                        <span><strong>Competitor</strong><br /><span class="text-xs text-gray-500">Shooting the event</span></span>
                                                    </label>
                                                    <label class="option-tile">
                                                        <input type="radio" asp-for="Booking.Participants[i].AttendanceType" value="Spectator" />
                                                        <span><strong>Spectator</strong><br /><span class="text-xs text-gray-500">Attending, not shooting</span></span>
                                                    </label>
                                                </div>
                                                <span asp-validation-for="Booking.Participants[i].AttendanceType" class="form-error"></span>
                                                <div class="spectator-note legal-box mt-3" style="background:#eff6ff;border-color:#bfdbfe;color:#1e3a8a;">
                                                    <p><strong>Registered as a spectator.</strong> No rifle, division or shoot details are needed and <strong>no entry fee applies</strong> &mdash; only meals, if you book any. The indemnity and media release below still need to be signed.</p>
                                                </div>
                                            </div>
                                        }

                                        <div class="competitor-only space-y-4">
                                            <div>
                                                <label class="form-label">Rifle Type <span class="text-red-600">*</span></label>
                                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                                    @if (benchrest)
                                                    {
                                                        <label class="option-tile"><input type="radio" asp-for="Booking.Participants[i].GunType" value="PCP .177" /><span>PCP .177</span></label>
                                                        <label class="option-tile"><input type="radio" asp-for="Booking.Participants[i].GunType" value="PCP .22" /><span>PCP .22</span></label>
                                                        <label class="option-tile"><input type="radio" asp-for="Booking.Participants[i].GunType" value="Recoil / Springer" /><span>Recoil / Springer</span></label>
                                                    }
                                                    else
                                                    {
                                                        <label class="option-tile"><input type="radio" asp-for="Booking.Participants[i].GunType" value="PCP" /><span>PCP</span></label>
                                                        <label class="option-tile"><input type="radio" asp-for="Booking.Participants[i].GunType" value="Recoil / Springer" /><span>Recoil / Springer</span></label>
                                                    }
                                                </div>
                                                <span asp-validation-for="Booking.Participants[i].GunType" class="form-error"></span>
                                            </div>

                                            @if (ev.AllowsClubRifle)
                                            {
                                                <div>
                                                    <label class="form-label">Rifle Ownership <span class="text-red-600">*</span></label>
                                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                                        <label class="option-tile">
                                                            <input type="radio" asp-for="Booking.Participants[i].RifleOwnership" value="Own" />
                                                            <span>Own air-rifle and pellets</span>
                                                        </label>
                                                        <label class="option-tile">
                                                            <input type="radio" asp-for="Booking.Participants[i].RifleOwnership" value="Club" />
                                                            <span>Needs a club air-rifle and pellets</span>
                                                        </label>
                                                    </div>
                                                    @if (ev.ClubRifleFee.HasValue && ev.ClubRifleFee.Value > 0)
                                                    {
                                                        <p class="form-hint mt-2"><strong>Please note:</strong> a club air-rifle adds <strong>@($"R{ev.ClubRifleFee.Value:F2}")</strong> for this person.</p>
                                                    }
                                                    <span asp-validation-for="Booking.Participants[i].RifleOwnership" class="form-error"></span>
                                                </div>
                                            }

                                            @if (ev.RequiresDivision)
                                            {
                                                <div>
                                                    <label class="form-label">Division <span class="text-red-600">*</span></label>
                                                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                                                        <label class="option-tile"><input type="radio" asp-for="Booking.Participants[i].Division" value="Open PCP" /><span>Open PCP</span></label>
                                                        <label class="option-tile"><input type="radio" asp-for="Booking.Participants[i].Division" value="Ladies" /><span>Ladies</span></label>
                                                        <label class="option-tile"><input type="radio" asp-for="Booking.Participants[i].Division" value="U/18" /><span>Under 18</span></label>
                                                        <label class="option-tile"><input type="radio" asp-for="Booking.Participants[i].Division" value="U/13" /><span>Under 13</span></label>
                                                    </div>
                                                    <div class="mt-3">
                                                        <label class="option-tile">
                                                            <input type="radio" asp-for="Booking.Participants[i].Division" value="Other" />
                                                            <span class="flex-1">
                                                                <strong>Other:</strong>
                                                                <input type="text" asp-for="Booking.Participants[i].OtherDivision" class="form-input mt-2" placeholder="Specify division" />
                                                            </span>
                                                        </label>
                                                    </div>
                                                    <span asp-validation-for="Booking.Participants[i].Division" class="form-error"></span>
                                                </div>
                                            }

                                            @if (ev.IsDoubleHeader)
                                            {
                                                <div>
                                                    <label class="form-label">Shoot Selection <span class="text-red-600">*</span></label>
                                                    <div class="space-y-2">
                                                        <label class="option-tile">
                                                            <input type="radio" asp-for="Booking.Participants[i].ShootSelection" value="First" />
                                                            <span><strong>First shoot only</strong> &middot; @($"R{singleFee:F2}")</span>
                                                        </label>
                                                        <label class="option-tile">
                                                            <input type="radio" asp-for="Booking.Participants[i].ShootSelection" value="Second" />
                                                            <span><strong>Second shoot only</strong> &middot; @($"R{singleFee:F2}")</span>
                                                        </label>
                                                        <label class="option-tile">
                                                            <input type="radio" asp-for="Booking.Participants[i].ShootSelection" value="Both" />
                                                            <span><strong>Both shoots</strong> &middot; @($"R{bothFee:F2}")</span>
                                                        </label>
                                                    </div>
                                                    <span asp-validation-for="Booking.Participants[i].ShootSelection" class="form-error"></span>
                                                </div>
                                            }

                                            @if (ev.RequiresClubName)
                                            {
                                                <div>
                                                    <label asp-for="Booking.Participants[i].ClubName" class="form-label">Club Name</label>
                                                    <input asp-for="Booking.Participants[i].ClubName" class="form-input" />
                                                    <p class="form-hint">Leave blank if not a member of a club.</p>
                                                </div>
                                            }

                                            @if (ev.RequiresSahfta)
                                            {
                                                <div>
                                                    <label asp-for="Booking.Participants[i].SAHFTANumber" class="form-label">Membership Number</label>
                                                    <input asp-for="Booking.Participants[i].SAHFTANumber" class="form-input" placeholder="e.g. 19-5001" />
                                                    <p class="form-hint">SAHFTA or club membership number. Leave blank if not applicable.</p>
                                                </div>
                                            }
                                        </div>

                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <div>
                                                <label asp-for="Booking.Participants[i].GuardianName" class="form-label">Guardian / Parent Name</label>
                                                <input asp-for="Booking.Participants[i].GuardianName" class="form-input" />
                                                <p class="form-hint">Only for anyone under 18.</p>
                                            </div>
                                            <div>
                                                <label asp-for="Booking.Participants[i].GuardianSurname" class="form-label">Guardian / Parent Surname</label>
                                                <input asp-for="Booking.Participants[i].GuardianSurname" class="form-input" />
                                            </div>
                                        </div>

                                        <div class="pt-2 border-t">
                                            <p class="font-semibold text-gray-700 mb-2 mt-3">Signatures for this person <span class="text-red-600">*</span></p>

                                            <label class="option-tile">
                                                <input type="checkbox" asp-for="Booking.Participants[i].InfoAccurateConfirmed" />
                                                <span>The information given for this person is accurate</span>
                                            </label>
                                            <span asp-validation-for="Booking.Participants[i].InfoAccurateConfirmed" class="form-error"></span>

                                            <label class="option-tile mt-2">
                                                <input type="checkbox" asp-for="Booking.Participants[i].IndemnityAgreed" />
                                                <span>I acknowledge the <strong>Indemnity Declaration</strong> above and provide my digital signature</span>
                                            </label>
                                            <label class="option-tile mt-2">
                                                <input type="checkbox" asp-for="Booking.Participants[i].GuardianIndemnityAgreed" />
                                                <span><em>(Under 18)</em> I, the Legal Guardian / Parent, agree to the indemnity above on this person's behalf and provide my digital signature</span>
                                            </label>
                                            <span asp-validation-for="Booking.Participants[i].IndemnityAgreed" class="form-error"></span>

                                            <p class="font-semibold text-gray-700 mb-2 mt-4">Media release for this person <span class="text-red-600">*</span></p>
                                            <div class="space-y-2">
                                                <label class="option-tile">
                                                    <input type="radio" asp-for="Booking.Participants[i].SocialMediaConsent" value="Agreed" />
                                                    <span>I acknowledge the media release above and provide my digital signature</span>
                                                </label>
                                                <label class="option-tile">
                                                    <input type="radio" asp-for="Booking.Participants[i].SocialMediaConsent" value="GuardianAgreed" />
                                                    <span><em>(Under 18)</em> I, the Legal Guardian / Parent, agree to the media release on this person's behalf</span>
                                                </label>
                                                <label class="option-tile">
                                                    <input type="radio" asp-for="Booking.Participants[i].SocialMediaConsent" value="Declined" />
                                                    <span>I do <strong>not</strong> give consent for the "Materials" to be used on any Social Media Platform</span>
                                                </label>
                                            </div>
                                            <span asp-validation-for="Booking.Participants[i].SocialMediaConsent" class="form-error"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (Model.Booking.Participants.Count < POLK_DOTNET.Pages.RegisterEventModel.MaxParticipants)
                        {
                            <div class="mt-4">
                                <button type="submit" asp-page-handler="AddParticipant" formnovalidate class="ghost-btn">
                                    ➕ Add another person to this booking
                                </button>
                                <p class="form-hint">Your answers so far are kept &mdash; this only adds an extra block to fill in.</p>
                            </div>
                        }
                        else
                        {
                            <p class="form-hint mt-4">A single booking covers up to @POLK_DOTNET.Pages.RegisterEventModel.MaxParticipants people. Please make a second booking for anyone else, or contact the club.</p>
                        }
                    </section>

                    @if (ev.OffersMeals)
                    {
                        <section id="meals">
                            <h2 class="section-heading">Additional Meals</h2>
                            <p class="text-sm text-gray-600 mb-4">
                                Optional &mdash; order meals for the people on this booking, including spectators and family who are just coming along.
                            </p>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
                                <div>
                                    <label asp-for="Booking.ExtraMeals" class="form-label">How many meals do you need?</label>
                                    <input asp-for="Booking.ExtraMeals" type="number" min="0" max="@POLK_DOTNET.Pages.RegisterEventModel.MaxExtraMeals" step="1" class="form-input" />
                                    <p class="form-hint">Leave as 0 if you don't need any.</p>
                                    <span asp-validation-for="Booking.ExtraMeals" class="form-error"></span>
                                </div>
                                <div class="legal-box">
                                    <p>
                                        <strong>@(string.IsNullOrWhiteSpace(ev.MealDescription) ? "Meal" : ev.MealDescription)</strong>
                                        @if (mealsOn)
                                        {
                                            <span>&mdash; <strong>@($"R{ev.MealFee!.Value:F2}")</strong> each, added to your total.</span>
                                        }
                                        else
                                        {
                                            <span>&mdash; no charge; we just need the numbers for catering.</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </section>
                    }

                    @if (chargesAnything)
                    {
                        <section id="payment">
                            <h2 class="section-heading">Payment</h2>
                            <p class="text-sm text-gray-700 mb-3">
                                Your total is worked out from everyone on this booking@(mealsOn ? " plus any meals" : "") and is confirmed on the next screen and in your email.
                                @if (mealsOn)
                                {
                                    <span class="block mt-1 text-gray-600">Spectators pay no entry fee, but meals are charged for everyone.</span>
                                }
                            </p>

                            <label class="form-label">Payment Method <span class="text-red-600">*</span></label>
                            <div class="space-y-2">
                                @if (ev.EnableYocoPayment)
                                {
                                    <label class="option-tile">
                                        <input type="radio" asp-for="Booking.PaymentMethod" value="Yoco" />
                                        <span><strong>💳 Pay online now</strong><br /><span class="text-xs text-gray-500">Secure card payment</span></span>
                                    </label>
                                }
                                @if (!string.IsNullOrWhiteSpace(ev.BankingDetailsHtml))
                                {
                                    <label class="option-tile">
                                        <input type="radio" asp-for="Booking.PaymentMethod" value="EFT" />
                                        <span><strong>🏦 Pay by EFT</strong><br /><span class="text-xs text-gray-500">Banking details will be emailed to you</span></span>
                                    </label>
                                }
                                <label class="option-tile">
                                    <input type="radio" asp-for="Booking.PaymentMethod" value="AtVenue" />
                                    <span><strong>💵 Pay at the venue</strong><br /><span class="text-xs text-gray-500">Card machine or cash available on the day</span></span>
                                </label>
                            </div>
                            <span asp-validation-for="Booking.PaymentMethod" class="form-error"></span>

                            @if (!string.IsNullOrWhiteSpace(ev.BankingDetailsHtml))
                            {
                                <details class="mt-4 bg-gray-50 p-3 rounded-md text-sm border">
                                    <summary class="cursor-pointer font-medium">View banking details</summary>
                                    <div class="mt-2 prose max-w-none">@Html.Raw(ev.BankingDetailsHtml)</div>
                                </details>

                                <div class="mt-4">
                                    <label asp-for="Booking.PaymentReference" class="form-label">EFT Payment Reference (if already paid)</label>
                                    <input asp-for="Booking.PaymentReference" class="form-input" placeholder="Your payment reference" />
                                </div>
                            }
                        </section>
                    }

                    <button type="submit" class="submit-btn">
                        Submit Registration
                    </button>

                    <p class="text-center text-xs text-gray-500">
                        By submitting, you confirm the declarations signed above and that the information is accurate.
                    </p>
                </form>
            }
        </div>

        <div class="text-center mt-6 text-sm text-gray-500">
            Pretoria Oos Lug Geweer Klub &middot; <a href="/" class="hover:underline">polk-hft.co.za</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // A rejected submit re-renders from the top of the document. On a booking that runs to
        // several people the reason sits well below the fold, which reads as "nothing happened".
        // Move the view and focus onto it so it is announced as well as seen.
        (function () {
            var problems = document.getElementById('problems');
            if (!problems) return;
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            problems.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
            problems.focus({ preventScroll: true });
        })();
    </script>
}
