@page "/admin/events/{id:int}"
@model POLK_DOTNET.Pages.AdminEvents.ManageModel
@{
    ViewData["Title"] = $"Manage: {Model.Event.Title}";
    var regUrl = $"{Request.Scheme}://{Request.Host}/RegisterEvent/{Model.Event.Id}";
}

<div class="container mx-auto px-4 py-8">
    <a asp-page="Index" class="text-sm text-gray-500 hover:underline">&larr; All Events</a>

    <!-- Event summary + stats -->
    <div class="bg-white rounded-lg shadow-md p-6 mt-2 mb-6">
        <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
                <h1 class="text-3xl font-bold">@Model.Event.Title</h1>
                <p class="text-gray-600">@Model.Event.StartDate.ToString("dd MMMM yyyy") &middot; @Model.Event.Time &middot; @Model.Event.Location</p>
                <p class="text-sm text-gray-500 mt-1">Type: <strong>@Model.Event.EventType</strong>
                    @if (Model.Event.EntryFee.HasValue)
                    {
                        <span>&middot; Entry: <strong>@($"R{Model.Event.EntryFee.Value:F2}")</strong></span>
                    }
                </p>
            </div>
            <div class="flex flex-col gap-2 items-end">
                @if (Model.Event.IsRegistrationOpen)
                {
                    <span class="inline-flex items-center px-3 py-1 rounded text-sm font-semibold bg-green-100 text-green-800">Registration Open</span>
                }
                else
                {
                    <span class="inline-flex items-center px-3 py-1 rounded text-sm font-semibold bg-gray-200 text-gray-700">Registration Closed</span>
                }
                <div class="flex gap-2">
                    <form method="post" asp-page-handler="ToggleRegistration" asp-route-id="@Model.Event.Id">
                        <button type="submit" class="text-xs px-3 py-1 border rounded hover:bg-gray-100">@(Model.Event.IsRegistrationOpen ? "Close" : "Open") Registration</button>
                    </form>
                    <a asp-page="/EditEvent" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 border rounded hover:bg-gray-100">Edit Event</a>
                    @if (Model.Event.EventType == "HFT" && Model.Event.IsLeagueShoot)
                    {
                        <a asp-page="Course" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 bg-blue-700 text-white rounded hover:bg-blue-800">
                            Course Setup
                            @if (Model.Event.CourseTargetCount.HasValue)
                            {
                                <span>(@Model.Event.CourseTargetCount)</span>
                            }
                        </a>
                        @if (Model.Event.CourseTargetCount.HasValue)
                        {
                            <a asp-page-handler="SampleScorecard" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 bg-gray-700 text-white rounded hover:bg-gray-800">Sample Scorecard</a>
                            <a asp-page-handler="SampleScorecardUneven" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 bg-gray-500 text-white rounded hover:bg-gray-600">Sample (Uneven Lanes)</a>
                            <a asp-page-handler="GenerateScorecards" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 bg-green-700 text-white rounded hover:bg-green-800 font-semibold">Generate All Scorecards</a>
                        }
                    }
                </div>
            </div>
        </div>

        @if (Model.Event.IsRegistrationOpen)
        {
            <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded-md">
                <p class="text-sm font-medium text-green-900 mb-1">Share this registration link:</p>
                <div class="flex items-center gap-2">
                    <a href="@regUrl" target="_blank" class="text-sm text-blue-700 hover:underline break-all">@regUrl</a>
                    <button type="button" onclick="copyUrl(this, '@regUrl')" class="text-xs px-3 py-1 bg-white border rounded hover:bg-gray-100 whitespace-nowrap">Copy</button>
                </div>
            </div>
        }

        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mt-6">
            <div class="p-3 bg-gray-50 rounded text-center"><div class="text-2xl font-bold">@Model.TotalCount</div><div class="text-xs text-gray-600">Total</div></div>
            <div class="p-3 bg-green-50 rounded text-center"><div class="text-2xl font-bold text-green-700">@Model.PaidCount</div><div class="text-xs text-gray-600">Paid</div></div>
            <div class="p-3 bg-yellow-50 rounded text-center"><div class="text-2xl font-bold text-yellow-700">@Model.PendingCount</div><div class="text-xs text-gray-600">Pending</div></div>
            <div class="p-3 bg-blue-50 rounded text-center"><div class="text-2xl font-bold text-blue-700">@Model.ConfirmedCount</div><div class="text-xs text-gray-600">Confirmed</div></div>
            <div class="p-3 bg-red-50 rounded text-center"><div class="text-2xl font-bold text-red-700">@Model.CancelledCount</div><div class="text-xs text-gray-600">Cancelled</div></div>
        </div>
    </div>

    <!-- Registrations -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
            <h2 class="text-2xl font-bold">Registrations</h2>
            <a asp-page-handler="ExportCsv" asp-route-id="@Model.Event.Id" asp-route-Search="@Model.Search" asp-route-StatusFilter="@Model.StatusFilter" class="px-3 py-2 bg-gray-700 text-white rounded text-sm hover:bg-gray-800">Export CSV</a>
        </div>

        <form method="get" class="flex flex-wrap gap-2 mb-4">
            <input type="hidden" name="id" value="@Model.Event.Id" />
            <input type="text" name="Search" value="@Model.Search" placeholder="Search name, email, cell..." class="flex-1 min-w-[200px] px-3 py-2 border rounded-md" />
            <select name="StatusFilter" class="px-3 py-2 border rounded-md">
                @{
                    var opts = new[] { "All", "Pending", "Paid", "Confirmed", "Cancelled" };
                }
                @foreach (var opt in opts)
                {
                    if (Model.StatusFilter == opt || (string.IsNullOrEmpty(Model.StatusFilter) && opt == "All"))
                    {
                        <option value="@opt" selected>@opt</option>
                    }
                    else
                    {
                        <option value="@opt">@opt</option>
                    }
                }
            </select>
            <button type="submit" class="px-4 py-2 bg-red-700 text-white rounded-md">Filter</button>
            <a asp-page="Manage" asp-route-id="@Model.Event.Id" class="px-4 py-2 border rounded-md hover:bg-gray-100">Reset</a>
        </form>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="text-left p-3">Name</th>
                        <th class="text-left p-3">Email</th>
                        <th class="text-left p-3">Cell</th>
                        <th class="text-left p-3">Gun</th>
                        <th class="text-left p-3">Division</th>
                        <th class="text-left p-3">Payment</th>
                        <th class="text-left p-3">Status</th>
                        <th class="text-left p-3">Amount</th>
                        <th class="text-left p-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Registrations)
                    {
                        <tr class="border-b last:border-none hover:bg-gray-50">
                            <td class="p-3 whitespace-nowrap">
                                <a asp-page="Registration" asp-route-id="@Model.Event.Id" asp-route-regId="@r.Id" class="font-medium text-red-700 hover:underline">@r.Name @r.Surname</a>
                            </td>
                            <td class="p-3">@r.EmailAddress</td>
                            <td class="p-3 whitespace-nowrap">@r.CellNumber</td>
                            <td class="p-3 whitespace-nowrap">@r.GunType</td>
                            <td class="p-3 whitespace-nowrap">@(r.Division ?? "-")</td>
                            <td class="p-3 whitespace-nowrap">@(r.PaymentMethod ?? "-")</td>
                            <td class="p-3">
                                @{
                                    var badge = r.Status switch
                                    {
                                        "Paid" => "bg-green-100 text-green-800",
                                        "Pending" => "bg-yellow-100 text-yellow-800",
                                        "Confirmed" => "bg-blue-100 text-blue-800",
                                        "Cancelled" => "bg-red-100 text-red-800",
                                        _ => "bg-gray-100 text-gray-800"
                                    };
                                }
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold @badge">@r.Status</span>
                            </td>
                            <td class="p-3 whitespace-nowrap">@($"R{r.AmountPaid:F2}")</td>
                            <td class="p-3">
                                <div class="flex flex-wrap gap-1">
                                    <a asp-page="Registration" asp-route-id="@Model.Event.Id" asp-route-regId="@r.Id" class="text-xs px-2 py-1 border rounded hover:bg-gray-100">View</a>
                                    @if (r.Status != "Paid")
                                    {
                                        <form method="post" asp-page-handler="MarkPaid" asp-route-id="@Model.Event.Id">
                                            <input type="hidden" name="registrationId" value="@r.Id" />
                                            <button type="submit" class="text-xs px-2 py-1 bg-green-600 text-white rounded hover:bg-green-700">Mark Paid</button>
                                        </form>
                                    }
                                    @if (r.Status != "Cancelled")
                                    {
                                        <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Event.Id" onsubmit="return confirm('Cancel this registration?');">
                                            <input type="hidden" name="registrationId" value="@r.Id" />
                                            <button type="submit" class="text-xs px-2 py-1 border border-red-300 text-red-700 rounded hover:bg-red-50">Cancel</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Registrations.Any())
                    {
                        <tr><td colspan="9" class="p-8 text-center text-gray-500">No registrations match the current filters.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function copyUrl(btn, url) {
        navigator.clipboard.writeText(url).then(function () {
            var original = btn.textContent;
            btn.textContent = 'Copied!';
            setTimeout(function () { btn.textContent = original; }, 1500);
        });
    }
</script>
