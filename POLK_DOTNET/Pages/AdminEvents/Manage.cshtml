@page "/admin/events/{id:int}"
@model POLK_DOTNET.Pages.AdminEvents.ManageModel
@{
    ViewData["Title"] = $"Manage: {Model.Event.Title}";
    var regUrl = $"{Request.Scheme}://{Request.Host}/RegisterEvent/{Model.Event.Id}";
}

<div class="container mx-auto px-4 py-8">
    <a asp-page="Index" class="text-sm text-gray-500 hover:underline">&larr; All Events</a>

    <!-- Event summary + stats -->
    <div class="bg-white rounded-lg shadow-md p-6 mt-2 mb-6">
        <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
                <h1 class="text-3xl font-bold">@Model.Event.Title</h1>
                <p class="text-gray-600">
                    @if (Model.Event.IsProvincialTwoDay && Model.Event.EndDate.HasValue)
                    {
                        <span>@Model.Event.StartDate.ToString("dd MMM yyyy") &ndash; @Model.Event.EndDate.Value.ToString("dd MMM yyyy")</span>
                    }
                    else
                    {
                        <span>@Model.Event.StartDate.ToString("dd MMMM yyyy")</span>
                    }
                    &middot; @Model.Event.Time &middot; @Model.Event.Location
                </p>
                <p class="text-sm text-gray-500 mt-1">Type: <strong>@Model.Event.EventType</strong>
                    @if (Model.Event.EntryFee.HasValue)
                    {
                        <span>&middot; Entry: <strong>@($"R{Model.Event.EntryFee.Value:F2}")</strong></span>
                    }
                    @if (Model.Event.MealsChargeable)
                    {
                        <span>&middot; Meals: <strong>@($"R{Model.Event.MealFee!.Value:F2}")</strong> each</span>
                    }
                </p>
                <div class="flex flex-wrap gap-2 mt-2">
                    @if (Model.Event.IsProvincialTwoDay)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-indigo-100 text-indigo-800">Provincial &middot; two days</span>
                    }
                    @if (Model.Event.IsDoubleHeader)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-purple-100 text-purple-800">Double Header</span>
                    }
                </div>
            </div>
            <div class="flex flex-col gap-2 items-end">
                @if (Model.Event.IsRegistrationOpen)
                {
                    <span class="inline-flex items-center px-3 py-1 rounded text-sm font-semibold bg-green-100 text-green-800">Registration Open</span>
                }
                else
                {
                    <span class="inline-flex items-center px-3 py-1 rounded text-sm font-semibold bg-gray-200 text-gray-700">Registration Closed</span>
                }
                <div class="flex gap-2">
                    <form method="post" asp-page-handler="ToggleRegistration" asp-route-id="@Model.Event.Id">
                        <button type="submit" class="text-xs px-3 py-1 border rounded hover:bg-gray-100">@(Model.Event.IsRegistrationOpen ? "Close" : "Open") Registration</button>
                    </form>
                    <a asp-page="/EditEvent" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 border rounded hover:bg-gray-100">Edit Event</a>
                    @if (Model.Event.UsesCourseSetup)
                    {
                        var round = Model.Event.RoundLabel;
                        <a asp-page="Course" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 bg-blue-700 text-white rounded hover:bg-blue-800">
                            Course Setup
                            @if (Model.Event.CourseTargetCount.HasValue)
                            {
                                <span>(@Model.Event.CourseTargetCount)</span>
                            }
                        </a>
                        @if (Model.CourseConfigured)
                        {
                            <a asp-page-handler="SampleScorecardUneven" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 bg-gray-500 text-white rounded hover:bg-gray-600">Sample (Uneven Lanes)</a>

                            @if (Model.Event.HasTwoRounds)
                            {
                                @if (Model.Shoot1Ready)
                                {
                                    <a asp-page-handler="SampleScorecard" asp-route-id="@Model.Event.Id" asp-route-shoot="1" class="text-xs px-3 py-1 bg-gray-700 text-white rounded hover:bg-gray-800">Sample (@round 1)</a>
                                    <a asp-page-handler="GenerateScorecards" asp-route-id="@Model.Event.Id" asp-route-shoot="1" class="text-xs px-3 py-1 bg-green-700 text-white rounded hover:bg-green-800 font-semibold">Generate @round 1 Cards</a>
                                    <a asp-page-handler="Scoresheet" asp-route-id="@Model.Event.Id" asp-route-shoot="1" class="text-xs px-3 py-1 bg-blue-700 text-white rounded hover:bg-blue-800">Score Sheet (@round 1)</a>
                                }
                                @if (Model.Shoot2Ready)
                                {
                                    <a asp-page-handler="SampleScorecard" asp-route-id="@Model.Event.Id" asp-route-shoot="2" class="text-xs px-3 py-1 bg-gray-700 text-white rounded hover:bg-gray-800">Sample (@round 2)</a>
                                    <a asp-page-handler="GenerateScorecards" asp-route-id="@Model.Event.Id" asp-route-shoot="2" class="text-xs px-3 py-1 bg-green-700 text-white rounded hover:bg-green-800 font-semibold">Generate @round 2 Cards</a>
                                    <a asp-page-handler="Scoresheet" asp-route-id="@Model.Event.Id" asp-route-shoot="2" class="text-xs px-3 py-1 bg-blue-700 text-white rounded hover:bg-blue-800">Score Sheet (@round 2)</a>
                                }
                            }
                            else
                            {
                                <a asp-page-handler="SampleScorecard" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 bg-gray-700 text-white rounded hover:bg-gray-800">Sample Scorecard</a>
                                <a asp-page-handler="GenerateScorecards" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 bg-green-700 text-white rounded hover:bg-green-800 font-semibold">Generate All Scorecards</a>
                                <a asp-page-handler="Scoresheet" asp-route-id="@Model.Event.Id" class="text-xs px-3 py-1 bg-blue-700 text-white rounded hover:bg-blue-800">Score Sheet (Excel)</a>
                            }
                        }
                    }
                </div>
            </div>
        </div>

        @if (Model.Event.IsRegistrationOpen)
        {
            <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded-md">
                <p class="text-sm font-medium text-green-900 mb-1">Share this registration link:</p>
                <div class="flex items-center gap-2">
                    <a href="@regUrl" target="_blank" class="text-sm text-blue-700 hover:underline break-all">@regUrl</a>
                    <button type="button" onclick="copyUrl(this, '@regUrl')" class="text-xs px-3 py-1 bg-white border rounded hover:bg-gray-100 whitespace-nowrap">Copy</button>
                </div>
            </div>
        }

        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mt-6">
            <div class="p-3 bg-gray-50 rounded text-center"><div class="text-2xl font-bold">@Model.TotalCount</div><div class="text-xs text-gray-600">Bookings</div></div>
            <div class="p-3 bg-green-50 rounded text-center"><div class="text-2xl font-bold text-green-700">@Model.PaidCount</div><div class="text-xs text-gray-600">Paid</div></div>
            <div class="p-3 bg-yellow-50 rounded text-center"><div class="text-2xl font-bold text-yellow-700">@Model.PendingCount</div><div class="text-xs text-gray-600">Pending</div></div>
            <div class="p-3 bg-blue-50 rounded text-center"><div class="text-2xl font-bold text-blue-700">@Model.ConfirmedCount</div><div class="text-xs text-gray-600">Confirmed</div></div>
            <div class="p-3 bg-red-50 rounded text-center"><div class="text-2xl font-bold text-red-700">@Model.CancelledCount</div><div class="text-xs text-gray-600">Cancelled</div></div>
        </div>

        <!-- Head counts across live bookings — what the range and the kitchen actually need -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-3">
            <div class="p-3 bg-gray-50 rounded text-center"><div class="text-2xl font-bold">@Model.PeopleCount</div><div class="text-xs text-gray-600">People</div></div>
            <div class="p-3 bg-gray-50 rounded text-center"><div class="text-2xl font-bold">@Model.CompetitorCount</div><div class="text-xs text-gray-600">Competitors</div></div>
            <div class="p-3 bg-gray-50 rounded text-center"><div class="text-2xl font-bold">@Model.SpectatorCount</div><div class="text-xs text-gray-600">Spectators</div></div>
            <div class="p-3 bg-gray-50 rounded text-center"><div class="text-2xl font-bold">@Model.MealsCount</div><div class="text-xs text-gray-600">Meals booked</div></div>
        </div>
    </div>

    @if (Model.Event.UsesCourseSetup)
    {
        var roundLabel = Model.Event.RoundLabel;
        <!-- Starting Lanes -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between flex-wrap gap-3 mb-3">
                <h2 class="text-2xl font-bold">Starting Lanes</h2>
                <div class="text-sm text-gray-600">
                    @if (Model.Event.HasTwoRounds)
                    {
                        <span>Assigned — @roundLabel 1: <strong>@Model.LanesAssignedShoot1</strong> &middot; @roundLabel 2: <strong>@Model.LanesAssignedShoot2</strong></span>
                    }
                    else
                    {
                        <span>Assigned: <strong>@Model.LanesAssignedShoot1</strong></span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.LaneImportMessage))
            {
                <div class="mb-3 p-3 bg-green-50 border border-green-200 rounded text-sm text-green-900">@Model.LaneImportMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.LaneImportError))
            {
                <div class="mb-3 p-3 bg-red-50 border border-red-200 rounded text-sm text-red-900">@Model.LaneImportError</div>
            }

            <p class="text-sm text-gray-600 mb-3">
                Upload the squadding spreadsheet to pre-fill the starting lane on each scorecard.
                @if (Model.Event.HasTwoRounds)
                {
                    <span>Use sheet tabs named <strong>@(roundLabel)1</strong> and <strong>@(roundLabel)2</strong>.</span>
                }
                Columns required: <strong>Name</strong>, <strong>Surname</strong>, <strong>Starting Lane</strong>.
                Rows that match exactly one person are assigned automatically; the rest appear below for manual matching.
            </p>

            <form method="post" asp-page-handler="ImportLanes" asp-route-id="@Model.Event.Id" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2">
                <input type="file" name="laneFile" accept=".xlsx" required
                       class="text-sm border rounded px-3 py-2 file:mr-3 file:py-1 file:px-3 file:rounded file:border-0 file:bg-gray-200 file:text-sm" />
                <button type="submit" class="px-4 py-2 bg-blue-700 text-white rounded text-sm hover:bg-blue-800">Import Lanes</button>
            </form>

            @if (Model.PendingLanes.Any())
            {
                <div class="mt-6 border-t pt-4">
                    <h3 class="text-lg font-semibold mb-1">Manual match needed (@Model.PendingLanes.Count)</h3>
                    <p class="text-sm text-gray-600 mb-3">These sheet rows didn't match exactly one person. Pick the right person for each, then save.</p>
                    <form method="post" asp-page-handler="AssignLanes" asp-route-id="@Model.Event.Id">
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead class="bg-gray-50 border-b">
                                    <tr>
                                        @if (Model.Event.HasTwoRounds)
                                        {
                                            <th class="text-left p-2">@roundLabel</th>
                                        }
                                        <th class="text-left p-2">From sheet</th>
                                        <th class="text-left p-2">Lane</th>
                                        <th class="text-left p-2">Assign to person</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.PendingLanes)
                                    {
                                        var candidates = p.Shoot == 2 ? Model.Shoot2Candidates : Model.Shoot1Candidates;
                                        <tr class="border-b last:border-none">
                                            <input type="hidden" name="shoots" value="@p.Shoot" />
                                            <input type="hidden" name="lanes" value="@p.Lane" />
                                            @if (Model.Event.HasTwoRounds)
                                            {
                                                <td class="p-2 whitespace-nowrap">@roundLabel @p.Shoot</td>
                                            }
                                            <td class="p-2 whitespace-nowrap font-medium">@($"{p.Name} {p.Surname}".Trim())</td>
                                            <td class="p-2 whitespace-nowrap">@p.Lane</td>
                                            <td class="p-2">
                                                <select name="regIds" class="w-full min-w-[220px] px-2 py-1 border rounded">
                                                    <option value="0">— skip —</option>
                                                    @foreach (var c in candidates)
                                                    {
                                                        var laneNow = p.Shoot == 2 ? c.StartingLaneShoot2 : c.StartingLaneShoot1;
                                                        var laneNote = laneNow.HasValue ? $" — lane {laneNow}" : "";
                                                        var div = string.IsNullOrWhiteSpace(c.Division) ? "" : $" · {c.Division}";
                                                        <option value="@c.Id">@c.Name @c.Surname@(div)@(laneNote)</option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="px-4 py-2 bg-green-700 text-white rounded text-sm hover:bg-green-800 font-semibold">Save Assignments</button>
                        </div>
                    </form>
                </div>
            }
        </div>
    }

    <!-- Registrations -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
            <h2 class="text-2xl font-bold">Registrations</h2>
            <div class="flex gap-2">
                <a asp-page-handler="UnpaidSheet" asp-route-id="@Model.Event.Id" class="px-3 py-2 bg-amber-600 text-white rounded text-sm hover:bg-amber-700">To Collect (Unpaid)</a>
                <a asp-page-handler="ExportCsv" asp-route-id="@Model.Event.Id" asp-route-Search="@Model.Search" asp-route-StatusFilter="@Model.StatusFilter" class="px-3 py-2 bg-gray-700 text-white rounded text-sm hover:bg-gray-800">Export CSV</a>
            </div>
        </div>

        <form method="get" class="flex flex-wrap gap-2 mb-4">
            <input type="hidden" name="id" value="@Model.Event.Id" />
            <input type="text" name="Search" value="@Model.Search" placeholder="Search contact or any person, email, cell..." class="flex-1 min-w-[200px] px-3 py-2 border rounded-md" />
            <select name="StatusFilter" class="px-3 py-2 border rounded-md">
                @{
                    var opts = new[] { "All", "Pending", "Paid", "Confirmed", "Cancelled" };
                }
                @foreach (var opt in opts)
                {
                    if (Model.StatusFilter == opt || (string.IsNullOrEmpty(Model.StatusFilter) && opt == "All"))
                    {
                        <option value="@opt" selected>@opt</option>
                    }
                    else
                    {
                        <option value="@opt">@opt</option>
                    }
                }
            </select>
            <button type="submit" class="px-4 py-2 bg-red-700 text-white rounded-md">Filter</button>
            <a asp-page="Manage" asp-route-id="@Model.Event.Id" class="px-4 py-2 border rounded-md hover:bg-gray-100">Reset</a>
        </form>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="text-left p-3">Booking contact</th>
                        <th class="text-left p-3">People</th>
                        <th class="text-left p-3">Email</th>
                        <th class="text-left p-3">Cell</th>
                        @if (Model.Event.OffersMeals)
                        {
                            <th class="text-left p-3">Meals</th>
                        }
                        <th class="text-left p-3">Payment</th>
                        <th class="text-left p-3">Status</th>
                        <th class="text-left p-3">Owing</th>
                        <th class="text-left p-3">Paid</th>
                        <th class="text-left p-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Registrations)
                    {
                        var people = r.Participants.OrderBy(p => p.Position).ToList();
                        <tr class="border-b last:border-none hover:bg-gray-50 align-top">
                            <td class="p-3 whitespace-nowrap">
                                <a asp-page="Registration" asp-route-id="@Model.Event.Id" asp-route-regId="@r.Id" class="font-medium text-red-700 hover:underline">@r.Name @r.Surname</a>
                            </td>
                            <td class="p-3">
                                @if (people.Count == 0)
                                {
                                    <span class="text-gray-400">—</span>
                                }
                                else
                                {
                                    <div class="text-xs space-y-0.5">
                                        @foreach (var p in people)
                                        {
                                            <div>
                                                <span class="font-medium">@p.FullName</span>
                                                @if (p.IsSpectator)
                                                {
                                                    <span class="text-gray-500">· spectator</span>
                                                }
                                                else
                                                {
                                                    @if (!string.IsNullOrWhiteSpace(p.Division))
                                                    {
                                                        <span class="text-gray-500">· @p.Division</span>
                                                    }
                                                    @if (Model.Event.IsDoubleHeader && !string.IsNullOrWhiteSpace(p.ShootSelection))
                                                    {
                                                        <span class="text-gray-500">· @(p.ShootSelection == "Both" ? "Both" : p.ShootSelection == "Second" ? "Shoot 2" : "Shoot 1")</span>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="p-3">@r.EmailAddress</td>
                            <td class="p-3 whitespace-nowrap">@r.CellNumber</td>
                            @if (Model.Event.OffersMeals)
                            {
                                <td class="p-3 whitespace-nowrap">@(r.ExtraMeals > 0 ? r.ExtraMeals.ToString() : "-")</td>
                            }
                            <td class="p-3 whitespace-nowrap">@(r.PaymentMethod ?? "-")</td>
                            <td class="p-3">
                                @{
                                    var badge = r.Status switch
                                    {
                                        "Paid" => "bg-green-100 text-green-800",
                                        "Pending" => "bg-yellow-100 text-yellow-800",
                                        "Confirmed" => "bg-blue-100 text-blue-800",
                                        "Cancelled" => "bg-red-100 text-red-800",
                                        _ => "bg-gray-100 text-gray-800"
                                    };
                                }
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold @badge">@r.Status</span>
                            </td>
                            <td class="p-3 whitespace-nowrap">@($"R{Model.BookingTotal(r):F2}")</td>
                            <td class="p-3 whitespace-nowrap">@($"R{r.AmountPaid:F2}")</td>
                            <td class="p-3">
                                <div class="flex flex-wrap gap-1">
                                    <a asp-page="Registration" asp-route-id="@Model.Event.Id" asp-route-regId="@r.Id" class="text-xs px-2 py-1 border rounded hover:bg-gray-100">View</a>
                                    @if (r.Status != "Paid")
                                    {
                                        <form method="post" asp-page-handler="MarkPaid" asp-route-id="@Model.Event.Id">
                                            <input type="hidden" name="registrationId" value="@r.Id" />
                                            <button type="submit" class="text-xs px-2 py-1 bg-green-600 text-white rounded hover:bg-green-700">Mark Paid</button>
                                        </form>
                                    }
                                    @if (r.Status != "Cancelled")
                                    {
                                        <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Event.Id" onsubmit="return confirm('Cancel this registration?');">
                                            <input type="hidden" name="registrationId" value="@r.Id" />
                                            <button type="submit" class="text-xs px-2 py-1 border border-red-300 text-red-700 rounded hover:bg-red-50">Cancel</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Registrations.Any())
                    {
                        var emptyColspan = Model.Event.OffersMeals ? 10 : 9;
                        <tr><td colspan="@emptyColspan" class="p-8 text-center text-gray-500">No registrations match the current filters.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function copyUrl(btn, url) {
        navigator.clipboard.writeText(url).then(function () {
            var original = btn.textContent;
            btn.textContent = 'Copied!';
            setTimeout(function () { btn.textContent = original; }, 1500);
        });
    }
</script>
