@page "/admin/events/{id:int}/course"
@model POLK_DOTNET.Pages.AdminEvents.CourseModel
@using POLK_DOTNET.Services
@{
    ViewData["Title"] = $"Course Setup — {Model.Event.Title}";
}

<div class="container mx-auto px-4 py-8">
    <a asp-page="Manage" asp-route-id="@Model.Event.Id" class="text-sm text-gray-500 hover:underline">&larr; Back to @Model.Event.Title</a>
    <h1 class="text-3xl font-bold mt-1 mb-2">Course Setup (Troyer)</h1>
    <p class="text-gray-600 mb-6">@Model.Event.Title &middot; @Model.Event.StartDate.ToString("dd MMMM yyyy")</p>

    @if (TempData["CourseSaved"] is string msg)
    {
        <div class="mb-4 p-3 bg-green-100 text-green-800 rounded-md">@msg</div>
    }

    @if (Model.ShowShootTabs)
    {
        <div class="flex items-center gap-2 mb-6 border-b pb-3">
            <span class="text-sm text-gray-500 mr-2">Editing:</span>
            <a asp-route-id="@Model.Event.Id" asp-route-shoot="1"
               class="px-4 py-2 rounded-md text-sm font-semibold @(Model.Shoot == 1 ? "bg-red-700 text-white" : "border hover:bg-gray-100")">
                Shoot 1
            </a>
            <a asp-route-id="@Model.Event.Id" asp-route-shoot="2"
               class="px-4 py-2 rounded-md text-sm font-semibold @(Model.Shoot == 2 ? "bg-red-700 text-white" : "border hover:bg-gray-100")">
                Shoot 2
            </a>
        </div>
    }

    @if (!Model.CurrentShootConfigured)
    {
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-bold mb-3">Select Troyer Variant @(Model.ShowShootTabs ? $"— Shoot {Model.Shoot}" : "")</h2>
            <p class="text-gray-600 mb-4">Choose the number of targets for this @(Model.ShowShootTabs ? "shoot's" : "event's") course. Normally done the day before the event.</p>
            <form method="post" asp-page-handler="SetTargetCount" class="flex gap-2">
                <input type="hidden" name="shoot" value="@Model.Shoot" />
                <button type="submit" name="targetCount" value="30" class="px-4 py-2 bg-red-700 text-white rounded hover:bg-red-800">30-Target Course</button>
                <button type="submit" name="targetCount" value="40" class="px-4 py-2 bg-red-700 text-white rounded hover:bg-red-800">40-Target Course</button>
            </form>
        </div>
    }
    else
    {
        <div class="flex items-center gap-4 mb-4 flex-wrap">
            <span class="text-lg font-semibold">@Model.CurrentTargetCount-Target Course</span>
            <form method="post" asp-page-handler="SetTargetCount" onsubmit="return confirm('Switching target count will reset all target data for this shoot. Continue?');">
                <input type="hidden" name="shoot" value="@Model.Shoot" />
                <input type="hidden" name="targetCount" value="@(Model.CurrentTargetCount == 30 ? 40 : 30)" />
                <button type="submit" class="text-xs px-3 py-1 border rounded hover:bg-gray-100">Switch to @(Model.CurrentTargetCount == 30 ? "40" : "30")-Target</button>
            </form>
            <a asp-page-handler="Export" asp-route-id="@Model.Event.Id" asp-route-shoot="@Model.Shoot" class="text-xs px-3 py-1 bg-blue-700 text-white rounded hover:bg-blue-800">Download Course (Excel)</a>
        </div>

        @* Summary panel *@
        @if (Model.Summary != null)
        {
            var s = Model.Summary;
            <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                <h2 class="text-xl font-bold mb-3">Course Summary</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
                    <div class="p-3 bg-gray-50 rounded">
                        <div class="text-xs text-gray-500">Standing / Required</div>
                        <div class="text-xl font-bold @(s.StandCount == s.RequiredStanding ? "text-green-700" : "text-red-700")">@s.StandCount / @s.RequiredStanding</div>
                    </div>
                    <div class="p-3 bg-gray-50 rounded">
                        <div class="text-xs text-gray-500">Kneeling / Required</div>
                        <div class="text-xl font-bold @(s.KneelCount == s.RequiredKneeling ? "text-green-700" : "text-red-700")">@s.KneelCount / @s.RequiredKneeling</div>
                    </div>
                    <div class="p-3 bg-gray-50 rounded">
                        <div class="text-xs text-gray-500">Ave Distance</div>
                        <div class="text-xl font-bold">@s.AverageDistance m</div>
                    </div>
                    <div class="p-3 bg-gray-50 rounded">
                        <div class="text-xs text-gray-500">Ave Difficulty</div>
                        <div class="text-xl font-bold">@s.AverageDifficulty</div>
                    </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-5 gap-2 text-sm mb-4">
                    <div class="p-2 bg-gray-50 rounded text-center"><div class="text-xs text-gray-500">35–40mm</div><div class="font-semibold">@s.Count35_40</div></div>
                    <div class="p-2 bg-gray-50 rounded text-center"><div class="text-xs text-gray-500">30–34mm</div><div class="font-semibold">@s.Count30_34</div></div>
                    <div class="p-2 bg-gray-50 rounded text-center"><div class="text-xs text-gray-500">25–29mm</div><div class="font-semibold">@s.Count25_29</div></div>
                    <div class="p-2 bg-gray-50 rounded text-center"><div class="text-xs text-gray-500">20–24mm</div><div class="font-semibold">@s.Count20_24</div></div>
                    <div class="p-2 bg-gray-50 rounded text-center"><div class="text-xs text-gray-500">15–19mm</div><div class="font-semibold">@s.Count15_19</div></div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-sm mb-4">
                    <div class="p-2 bg-red-50 rounded"><strong>Expert:</strong> @s.CountExp</div>
                    <div class="p-2 bg-yellow-50 rounded"><strong>Moderate:</strong> @s.CountMod</div>
                    <div class="p-2 bg-green-50 rounded"><strong>Easy:</strong> @s.CountEasy</div>
                    <div class="p-2 @(s.Count25to34 >= s.Required25to34Min ? "bg-green-50" : "bg-red-50") rounded"><strong>25–34mm:</strong> @s.Count25to34 / min @s.Required25to34Min</div>
                </div>

                @if (s.Errors.Count > 0)
                {
                    <div class="p-3 bg-red-50 border border-red-200 rounded text-sm">
                        <strong class="text-red-800">Course errors:</strong>
                        <ul class="list-disc list-inside mt-1 text-red-700">
                            @foreach (var err in s.Errors) { <li>@err</li> }
                        </ul>
                    </div>
                }
                else
                {
                    <div class="p-3 bg-green-50 border border-green-200 rounded text-sm text-green-800">✓ All course-level checks pass</div>
                }
            </div>
        }

        <form method="post" class="bg-white rounded-lg shadow-md p-6">
            <input type="hidden" name="shoot" value="@Model.Shoot" />
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b">
                        <tr>
                            <th class="p-2 text-left">Lane</th>
                            <th class="p-2 text-left">Target</th>
                            <th class="p-2 text-left">Posture</th>
                            <th class="p-2 text-center">Incl/Decl</th>
                            <th class="p-2 text-center">Shade</th>
                            <th class="p-2 text-left">Killzone (mm)</th>
                            <th class="p-2 text-left">Distance (m)</th>
                            <th class="p-2 text-left">Diff Factor</th>
                            <th class="p-2 text-left">Difficulty</th>
                            <th class="p-2 text-left">Rating</th>
                            <th class="p-2 text-left">Check</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Targets.Count; i++)
                        {
                            var t = Model.Targets[i];
                            Model.RowResults.TryGetValue(t.Id, out var rr);
                            <tr class="border-b last:border-none">
                                <td class="p-2">
                                    <input type="hidden" asp-for="Targets[i].Id" />
                                    <input type="hidden" asp-for="Targets[i].TargetNumber" />
                                    <input type="number" asp-for="Targets[i].Lane" class="w-16 px-2 py-1 border rounded" min="1" />
                                </td>
                                <td class="p-2 font-semibold">@t.TargetNumber</td>
                                <td class="p-2">
                                    <select asp-for="Targets[i].Posture" class="px-2 py-1 border rounded">
                                        <option value="Prone">Prone</option>
                                        <option value="UnStand">Unsupported Standing</option>
                                        <option value="UnKneel">Unsupported Kneeling</option>
                                        <option value="SupStand">Supported Standing</option>
                                        <option value="SupKneel">Supported Kneeling</option>
                                    </select>
                                </td>
                                <td class="p-2 text-center"><input type="checkbox" asp-for="Targets[i].IsInclineDecline" /></td>
                                <td class="p-2 text-center"><input type="checkbox" asp-for="Targets[i].IsShaded" /></td>
                                <td class="p-2"><input type="number" asp-for="Targets[i].KillZoneMm" class="w-20 px-2 py-1 border rounded" min="0" max="40" /></td>
                                <td class="p-2"><input type="number" step="0.1" asp-for="Targets[i].DistanceMeters" class="w-20 px-2 py-1 border rounded" min="0" /></td>
                                <td class="p-2 text-gray-700">@(rr?.DiffFactor.ToString("0.000") ?? "-")</td>
                                <td class="p-2 text-gray-700">@(rr?.DiffScore > 0 ? rr.DiffScore.ToString("0.00") : "-")</td>
                                <td class="p-2">
                                    @if (rr != null && !string.IsNullOrEmpty(rr.Rating))
                                    {
                                        var cls = rr.Rating switch
                                        {
                                            "Exp" => "bg-red-100 text-red-800",
                                            "Mod" => "bg-yellow-100 text-yellow-800",
                                            "Easy" => "bg-green-100 text-green-800",
                                            _ => "bg-gray-100 text-gray-800"
                                        };
                                        <span class="inline-flex px-2 py-0.5 rounded text-xs font-semibold @cls">@rr.Rating</span>
                                    }
                                </td>
                                <td class="p-2">
                                    @if (rr == null || rr.IsOk)
                                    {
                                        <span class="text-green-700 text-xs">OK</span>
                                    }
                                    else
                                    {
                                        <span class="text-red-700 text-xs" title="@string.Join(" • ", rr.Errors)">@rr.Errors.Count error@(rr.Errors.Count == 1 ? "" : "s")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-6 flex gap-2">
                <button type="submit" class="px-6 py-2 bg-red-700 text-white rounded-md hover:bg-red-800">Save Course</button>
                <a asp-page="Manage" asp-route-id="@Model.Event.Id" class="px-6 py-2 border rounded-md hover:bg-gray-100">Cancel</a>
            </div>
        </form>

        @* Show per-row errors below the table for visibility *@
        var rowsWithErrors = Model.RowResults.Where(kv => kv.Value.Errors.Count > 0).ToList();
        if (rowsWithErrors.Any())
        {
            <div class="mt-4 p-3 bg-red-50 border border-red-200 rounded text-sm">
                <strong class="text-red-800">Row errors:</strong>
                <ul class="list-disc list-inside mt-1 text-red-700">
                    @foreach (var kv in rowsWithErrors)
                    {
                        var targetNum = Model.Targets.FirstOrDefault(t => t.Id == kv.Key)?.TargetNumber;
                        foreach (var err in kv.Value.Errors)
                        {
                            <li>Target @targetNum: @err</li>
                        }
                    }
                </ul>
            </div>
        }
    }
</div>
