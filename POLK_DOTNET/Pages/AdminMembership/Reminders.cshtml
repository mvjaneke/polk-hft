@page "/admin/membership/reminders"
@model POLK_DOTNET.Pages.AdminMembership.RemindersModel
@{
    ViewData["Title"] = "Renewal reminders";
    var plan = Model.Plan;
    var people = plan.Recipients.Sum(r => r.Members.Count);
}

<div class="container mx-auto px-4 py-8">
    <partial name="_MembershipNav" model="@("reminders")" />

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="lg:col-span-2 space-y-6">

            <section class="bg-white rounded-lg shadow p-5">
                <h2 class="text-lg font-bold text-gray-900">Who gets a reminder</h2>
                <p class="text-sm text-gray-600 mt-1">
                    Members who paid for the year that's ending and haven't paid for the next one, starting
                    @(plan.EndingYear?.RenewalReminderDaysBefore ?? 10) days before the year ends. Each member is reminded once.
                    People who share an email address, like a family, get one email.
                </p>

                @if (plan.Blocker != null)
                {
                    <div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-4 text-amber-900">
                        <p class="font-semibold">Nothing will be sent yet</p>
                        <p class="text-sm mt-1">@plan.Blocker</p>
                    </div>
                }

                @if (plan.EndingYear != null)
                {
                    <p class="mt-4 text-gray-900">
                        <strong class="text-2xl tabular-nums">@people</strong>
                        @(people == 1 ? "member" : "members") in @plan.Recipients.Count @(plan.Recipients.Count == 1 ? "email" : "emails")
                        @(plan.Blocker == null ? "will be reminded" : "would be reminded")
                        for @plan.EndingYear.Name.
                        @if (plan.AlreadyReminded > 0) { <span class="text-gray-500">@plan.AlreadyReminded already reminded.</span> }
                    </p>

                    @if (plan.Recipients.Count > 0)
                    {
                        <div class="overflow-x-auto mt-3 border rounded-md">
                            <table class="w-full text-sm">
                                <thead class="bg-gray-50 text-left text-gray-600 border-b"><tr><th class="p-2">Email</th><th class="p-2">Members</th></tr></thead>
                                <tbody>
                                    @foreach (var r in plan.Recipients)
                                    {
                                        <tr class="border-b last:border-none">
                                            <td class="p-2">@r.EmailAddress</td>
                                            <td class="p-2">
                                                @foreach (var m in r.Members)
                                                {
                                                    <a href="/admin/membership/member/@m.Id" class="text-red-700 hover:underline mr-2">@m.FullName</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (plan.MissingEmail.Count > 0 || plan.FailedRepeatedly.Count > 0)
                    {
                        <div class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-900">
                            <p class="font-semibold">Can't be reminded by email</p>
                            <ul class="mt-1 space-y-0.5">
                                @foreach (var m in plan.MissingEmail)
                                {
                                    <li><a href="/admin/membership/member/@m.Id" class="underline">@m.FullName</a>: no email address</li>
                                }
                                @foreach (var m in plan.FailedRepeatedly)
                                {
                                    <li><a href="/admin/membership/member/@m.Id" class="underline">@m.FullName</a>: sending to @m.EmailAddress failed three times</li>
                                }
                            </ul>
                        </div>
                    }
                }
            </section>

            @if (Model.SampleEmail != null)
            {
                <section class="bg-white rounded-lg shadow p-5">
                    <h2 class="text-lg font-bold text-gray-900 mb-3">The email</h2>
                    <div class="border rounded-md p-4 text-sm text-gray-800 [&_h2]:text-lg [&_h2]:font-bold [&_h2]:mb-2 [&_p]:mb-2">
                        @Html.Raw(Model.SampleEmail)
                    </div>
                </section>
            }

            <section class="bg-white rounded-lg shadow overflow-x-auto">
                <h2 class="text-lg font-bold text-gray-900 p-5 pb-2">Sent</h2>
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 text-left text-gray-600 border-b"><tr><th class="p-3">When</th><th class="p-3">Member</th><th class="p-3">Email</th><th class="p-3">Year</th><th class="p-3">How</th><th class="p-3"></th></tr></thead>
                    <tbody>
                        @if (Model.Log.Count == 0)
                        {
                            <tr><td colspan="6" class="p-6 text-center text-gray-500">No reminders sent yet.</td></tr>
                        }
                        @foreach (var r in Model.Log)
                        {
                            <tr class="border-b last:border-none">
                                <td class="p-3 whitespace-nowrap">@r.SentAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>
                                <td class="p-3"><a class="text-red-700 hover:underline" href="/admin/membership/member/@r.ClubMemberId">@r.ClubMember.FullName</a></td>
                                <td class="p-3">@r.EmailAddress</td>
                                <td class="p-3">@r.ShootingYear.Name</td>
                                <td class="p-3">@(r.Trigger == "Admin" ? "Send now" : "Automatic")</td>
                                <td class="p-3 @(r.Success ? "text-green-700" : "text-red-700")">@(r.Success ? "Sent" : "Failed")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </div>

        <div class="space-y-6">
            <section class="bg-white rounded-lg shadow p-5">
                <h2 class="text-lg font-bold text-gray-900">Automatic reminders</h2>
                <p class="mt-2 text-2xl font-bold @(Model.Enabled ? "text-green-700" : "text-gray-500")">@(Model.Enabled ? "On" : "Off")</p>
                <p class="text-sm text-gray-600 mt-1">
                    @(Model.Enabled
                        ? "The site checks every hour during office hours and sends any reminders that are due."
                        : "Nothing is sent automatically. Check the list on the left, then switch this on.")
                </p>
                @if (Model.AutoRunBlockedHere)
                {
                    <p class="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded p-2 mt-2">This is a development copy of the site: it never sends reminders by itself, whatever this switch says.</p>
                }
                <form method="post" asp-page-handler="Toggle" class="mt-4">
                    <input type="hidden" name="enable" value="@(Model.Enabled ? "false" : "true")" />
                    <button class="w-full px-4 py-2 rounded-md font-semibold @(Model.Enabled ? "border border-gray-300 bg-white hover:bg-gray-50" : "bg-red-700 text-white hover:bg-red-800")">
                        @(Model.Enabled ? "Switch off" : "Switch on")
                    </button>
                </form>
            </section>

            <section class="bg-white rounded-lg shadow p-5">
                <h2 class="text-lg font-bold text-gray-900">Send now</h2>
                <p class="text-sm text-gray-600 mt-1">Sends the reminders listed on the left straight away, without waiting for the hourly check. Nobody is reminded twice.</p>
                <form method="post" asp-page-handler="SendNow" class="mt-4">
                    <button class="w-full px-4 py-2 rounded-md border font-semibold @(plan.Blocker == null && plan.Recipients.Count > 0 ? "border-red-700 text-red-700 bg-white hover:bg-red-50" : "border-gray-200 text-gray-400 bg-gray-50 cursor-not-allowed")"
                            disabled="@(plan.Blocker != null || plan.Recipients.Count == 0)">
                        Send @plan.Recipients.Count @(plan.Recipients.Count == 1 ? "reminder" : "reminders") now
                    </button>
                </form>
                @if (!string.IsNullOrEmpty(Model.LastRun))
                {
                    <p class="text-xs text-gray-500 mt-3">Last run: @Model.LastRun</p>
                }
            </section>
        </div>
    </div>
</div>
