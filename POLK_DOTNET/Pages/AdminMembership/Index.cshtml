@page "/admin/membership"
@model POLK_DOTNET.Pages.AdminMembership.IndexModel
@using POLK_DOTNET.Data
@using POLK_DOTNET.Services
@{
    ViewData["Title"] = "Membership Applications";
    var filters = new[]
    {
        ("all", "All"),
        ("attention", "Needs action"),
        ("unpaid", "Unpaid"),
        ("paid", "Paid"),
        ("flagged", "To check"),
        ("rejected", "Rejected"),
        ("closed", "Closed"),
    };
}

<div class="container mx-auto px-4 py-8">
    <partial name="_MembershipNav" model="@("applications")" />

    <form method="get" class="flex flex-wrap items-end gap-4 mb-4">
        <div>
            <label for="YearId" class="block text-sm font-semibold text-gray-700 mb-1">Shooting year</label>
            <select id="YearId" name="YearId" class="border border-gray-300 rounded-md px-3 py-2 bg-white">
                @foreach (var y in Model.Years)
                {
                    <option value="@y.Id" selected="@(y.Id == Model.YearId)">@y.Name</option>
                }
                <option value="-1" selected="@(Model.YearId == -1)">Before shooting years</option>
                <option value="0" selected="@(Model.YearId == 0)">All years</option>
            </select>
        </div>
        <input type="hidden" name="Show" value="@Model.Show" />
        <button type="submit" class="px-4 py-2 rounded-md border border-gray-300 bg-white hover:bg-gray-50">Show</button>
    </form>

    <div class="flex flex-wrap gap-2 mb-4" role="tablist">
        @foreach (var (key, label) in filters)
        {
            var active = Model.Show == key;
            <a href="?YearId=@Model.YearId&Show=@key"
               class="px-3 py-1.5 rounded-full text-sm border @(active ? "bg-red-700 border-red-700 text-white" : "bg-white border-gray-300 text-gray-700 hover:border-red-700")">
                @label <span class="@(active ? "text-red-100" : "text-gray-500")">@Model.Counts.GetValueOrDefault(key)</span>
            </a>
        }
    </div>

    <div class="overflow-x-auto bg-white rounded-lg shadow">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b text-left text-gray-600">
                <tr>
                    <th class="p-3">#</th>
                    <th class="p-3">Submitted</th>
                    <th class="p-3">Who</th>
                    <th class="p-3">Membership</th>
                    <th class="p-3 text-right">Total</th>
                    <th class="p-3">Payment</th>
                    <th class="p-3">Approval</th>
                    <th class="p-3"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Applications.Count == 0)
                {
                    <tr><td colspan="8" class="p-8 text-center text-gray-500">No applications here@(Model.SelectedYear != null ? $" for {Model.SelectedYear.Name}" : "").</td></tr>
                }
                @foreach (var a in Model.Applications)
                {
                    var primary = a.Members.FirstOrDefault(m => m.IsPrimary) ?? a.Members.FirstOrDefault();
                    var others = a.Members.Count - 1;
                    <tr class="border-b last:border-none hover:bg-gray-50 align-top">
                        <td class="p-3 text-gray-500">@a.Id</td>
                        <td class="p-3 whitespace-nowrap">@a.SubmittedDate.ToLocalTime().ToString("d MMM yyyy")</td>
                        <td class="p-3">
                            <a href="/admin/membership/application/@a.Id" class="font-semibold text-red-700 hover:underline">@primary?.FirstName @primary?.Surname</a>
                            @if (others > 0) { <span class="text-gray-500"> + @others</span> }
                            <div class="text-xs text-gray-500">@primary?.EmailAddress</div>
                        </td>
                        <td class="p-3">
                            <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold @(a.ApplicationType == ApplicationTypes.Renewal ? "bg-blue-100 text-blue-800" : "bg-purple-100 text-purple-800")">@a.ApplicationType</span>
                            @a.MembershipType
                            <div class="text-xs text-gray-500">@a.ShootingYear?.Name</div>
                        </td>
                        <td class="p-3 text-right tabular-nums whitespace-nowrap">@MembershipService.Money(a.TotalAmount)</td>
                        <td class="p-3 whitespace-nowrap">
                            @if (a.IsPaid)
                            {
                                <span class="text-green-700 font-semibold">Paid</span>
                                <div class="text-xs text-gray-500">@a.PaidDate?.ToString("d MMM yyyy")</div>
                            }
                            else if (a.IsClosed)
                            {
                                <span class="text-gray-500 font-semibold">Not due</span>
                                <div class="text-xs text-gray-500">Closed</div>
                            }
                            else
                            {
                                <span class="text-amber-700 font-semibold">Unpaid</span>
                                <div class="text-xs text-gray-500">@(a.PaymentMethod == "EFT" ? "Paying by EFT" : "Card")</div>
                            }
                        </td>
                        <td class="p-3">
                            <span class="@(a.ApprovalStatus switch { "Approved" => "text-green-700", "Rejected" => "text-red-700", "Closed" => "text-gray-400", _ => "text-gray-600" })">@a.ApprovalStatus</span>
                        </td>
                        <td class="p-3">
                            @if (a.HasOpenFlags && !a.IsClosed)
                            {
                                <span class="inline-block px-2 py-0.5 rounded bg-amber-100 text-amber-900 text-xs font-semibold" title="@string.Join(" | ", a.FlagLines)">To check</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
